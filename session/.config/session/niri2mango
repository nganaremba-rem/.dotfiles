#!/usr/bin/env python3
"""niri2mango: generate mango bind.conf / env.conf / autostart.sh from the niri config.

niri (~/.config/niri) is the single source of truth. Run after editing it:
    niri2mango            # dry run: print the report only
    niri2mango --write    # write the mango files (old ones saved as *.prev)
"""
import re, shlex, sys
from pathlib import Path

NIRI = Path.home() / ".config/niri"
MANGO = Path.home() / ".config/mango"
HDR = "# GENERATED by ~/.config/session/niri2mango from ~/.config/niri. Do not edit; edit niri and re-run.\n"

# bind files in the same order config.kdl includes them (first bind on a key wins, like niri)
BIND_FILES = ["apps", "web-apps", "windows", "workspaces", "media", "screenshots", "session", "alt-tab", "extras"]

MODS = {"mod": "SUPER", "super": "SUPER", "ctrl": "CTRL", "alt": "ALT", "shift": "SHIFT"}
WHEEL = {"WheelScrollUp": "UP", "WheelScrollDown": "DOWN", "WheelScrollLeft": "LEFT", "WheelScrollRight": "RIGHT"}
DIRS = {"left": "left", "right": "right", "up": "up", "down": "down"}
SHOT = "~/Pictures/Screenshots/Screenshot\\ from\\ $(date +'%Y-%m-%d\\ %H-%M-%S').png"

# niri action -> mango "dispatch,args" (None = no twin; listed in the report)
FIXED = {
    "focus-column-left": "focusdir,left", "focus-column-right": "focusdir,right",
    "focus-window-up": "focusdir,up", "focus-window-down": "focusdir,down",
    "move-column-left": "exchange_client,left", "move-column-right": "exchange_client,right",
    "move-window-up": "exchange_client,up", "move-window-down": "exchange_client,down",
    "close-window": "killclient", "toggle-overview": "toggleoverview",
    "fullscreen-window": "togglefullscreen", "maximize-column": "togglemaximizescreen",
    "expand-column-to-available-width": "set_proportion,1.0",
    "toggle-window-floating": "togglefloating", "center-column": "centerwin",
    "switch-preset-column-width": "switch_proportion_preset",
    "consume-or-expel-window-left": "scroller_stack,left",
    "consume-or-expel-window-right": "scroller_stack,right",
    "consume-window-into-column": "scroller_stack,right",
    "expel-window-from-column": "scroller_stack,down",
    "focus-workspace-up": "viewtoleft", "focus-workspace-down": "viewtoright",
    "move-column-to-workspace-up": "tagtoleft", "move-column-to-workspace-down": "tagtoright",
    "next-window": "focusstack,next", "previous-window": "focusstack,prev",
    "quit": "quit",
    "screenshot": "spawn_shell,grim -g \"$(slurp)\" - | tee " + SHOT + " | wl-copy",
    "screenshot-screen": "spawn_shell,grim - | tee " + SHOT + " | wl-copy",
    "screenshot-window": "spawn_shell,grim -g \"$(mmsg get focusing-client | jq -r '\"\\(.x),\\(.y) \\(.width)x\\(.height)\"')\" - | tee " + SHOT + " | wl-copy",
    "power-off-monitors": "spawn_shell,niri msg action power-off-monitors",  # shim -> wlr-randr, any input wakes
    "show-hotkey-overlay": "spawn_shell,oq omarchy-menu-keybindings",
}
for d in DIRS:
    FIXED[f"focus-monitor-{d}"] = f"focusmon,{d}"
    FIXED[f"move-column-to-monitor-{d}"] = f"tagmon,{d}"
# no twin in mango: column tabs, window-height presets, floating<->tiling focus, workspace reorder, overlay, ...


def strip_comments(t):
    """Remove // comments, but not inside "quoted" strings."""
    out, i, q = [], 0, False
    while i < len(t):
        c = t[i]
        if q:
            out.append(c)
            if c == "\\":
                out.append(t[i + 1]); i += 1
            elif c == '"':
                q = False
        elif c == '"':
            q = True; out.append(c)
        elif t.startswith("//", i):
            while i < len(t) and t[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


TOKEN = re.compile(r'r(#*)"(.*?)"\1|"((?:[^"\\]|\\.)*)"|([^\s;{}"]+)', re.S)


def tokens(s):
    for m in TOKEN.finditer(s):
        if m.group(2) is not None: yield m.group(2)
        elif m.group(3) is not None: yield re.sub(r'\\(.)', r'\1', m.group(3))
        else: yield m.group(4)


def binds_blocks(text):
    """Yield (key, props, action-text) for each bind line inside binds { }."""
    text = strip_comments(text)
    # body has no braces, so wrapper blocks (binds { ... }) never match; props may hold quoted text
    for m in re.finditer(r'(?m)^[ \t]*([A-Za-z0-9_+]+)((?:[ \t]+[\w-]+=(?:"(?:[^"\\]|\\.)*"|[^\s{]+))*)[ \t]*\{([^{}]*)\}', text):
        key, props, body = m.groups()
        yield key, props, body.strip()


def conv_key(k):
    parts = k.split("+")
    mods = [MODS[p.lower()] for p in parts[:-1] if p.lower() in MODS]
    return mods, parts[-1]


def tilde_join(args):
    """shlex-join, but keep a leading ~/ unquoted so the shell expands it."""
    return " ".join(("~/" + shlex.quote(a[2:])) if a.startswith("~/") else shlex.quote(a) for a in args)


def convert(action_text):
    """Return (mango 'dispatch,args', note) for one action line."""
    toks = list(tokens(action_text))
    if not toks:
        return None, "empty"
    name, args = toks[0], toks[1:]
    if name == "spawn-sh":
        return "spawn_shell," + args[0], None
    if name == "spawn":
        return "spawn_shell," + tilde_join(args), None
    if name in ("focus-workspace", "move-column-to-workspace") and args and args[0].isdigit():
        return ("view," if name == "focus-workspace" else "tag,") + args[0], None
    if name in ("set-column-width", "set-window-height") and args:
        step = 100 if args[0].startswith("+") else -100
        return ("resizewin,%d,0" if name == "set-column-width" else "resizewin,0,%d") % step, None
    if name in ("next-window", "previous-window"):  # mango's thumbnail switcher; releasing Alt picks
        d = "next" if name == "next-window" else "prev"
        return (f"switcher,all_tag_{d}" if "output" in args else f"switcher,{d}"), None
    if name in FIXED:
        return FIXED[name], None
    return None, "no mango twin: " + name


def key_label(mods, key):
    """['SUPER','ALT'], 's' -> 'Super+Alt+S' (the form shown in the keybind list)."""
    return "+".join([m.capitalize() for m in mods] + [key.upper() if len(key) == 1 else key])


def tail_entries():
    """(label, title, command) for hand-written binds; the title is the comment line above."""
    tail, out, title = MANGO / "bind.tail.conf", [], ""
    if tail.exists():
        for line in tail.read_text().splitlines():
            if line.startswith("#"):
                title = line.lstrip("# ").strip()
            elif m := re.match(r'bind[a-z]*=([^,]*),([^,]*),(.*)', line):
                mods = [x.capitalize() for x in m[1].split("+") if x.upper() != "NONE"]
                cmd = m[3].split(",", 1)[-1] if m[3].startswith("spawn_shell") else m[3]
                out.append((key_label([x.upper() for x in mods], m[2].strip()), title or m[3].split(",")[0], cmd))
                title = ""  # a comment names only the bind right below it
            elif not line.strip():
                title = ""
    return out


def tail_keys():
    """Keys bound by hand in bind.tail.conf: they override the same key coming from niri."""
    tail, keys = MANGO / "bind.tail.conf", set()
    if tail.exists():
        for m in re.finditer(r'(?m)^bind[a-z]*=([^,]*),([^,]*),', tail.read_text()):
            mods = tuple(sorted(x.upper() for x in m[1].split("+") if x.upper() != "NONE"))
            keys.add((mods, m[2].strip().lower()))
    return keys


def parse_binds(write_scripts=False):
    seen, lines, report = tail_keys(), [], {"ported": 0, "dup": [], "skipped": []}
    entries = report["entries"] = tail_entries()  # hand-written binds first (they win)
    for f in BIND_FILES:
        for key, props, body in binds_blocks((NIRI / "binds" / f"{f}.kdl").read_text()):
            ck = conv_key(key)
            if not ck:
                continue
            mods, k = ck
            if re.search(r'\bdms\b', body):
                report["skipped"].append((key, "needs DMS (not running under mango)"))
                continue
            if "niri/scripts/" in body and "scripts/uclip" not in body:  # uclip asks mmsg when not on niri
                report["skipped"].append((key, "niri-only script: " + body[:60]))
                continue
            cmd, note = convert(body)
            if cmd is None:
                report["skipped"].append((key, note)); continue
            if len(cmd) > 200:  # mango limits a config value to 255 bytes: move the command into a script
                import hashlib
                name = hashlib.sha1(cmd.encode()).hexdigest()[:10]
                d = MANGO / "cmds"; d.mkdir(exist_ok=True)
                body = cmd.split(",", 1)[1]
                if write_scripts:
                    (d / f"{name}.sh").write_text(f"#!/bin/sh\n# {key}\n{body}\n"); (d / f"{name}.sh").chmod(0o755)
                cmd = f"spawn_shell,~/.config/mango/cmds/{name}.sh"
            t = re.search(r'hotkey-overlay-title="((?:[^"\\]|\\.)*)"', props)
            first = body.split()[0] if body.split() else ""
            title = t[1] if t else (first.replace("-", " ").capitalize() if not first.startswith("spawn") else cmd.split(",", 1)[-1])
            entry = (key_label(mods, k), title, cmd.split(",", 1)[-1] if cmd.startswith("spawn_shell") else cmd)
            kname = k.lower() if len(k) == 1 else k
            flag = "bindl" if "allow-when-locked=true" in props else "bind"
            if k in WHEEL:
                line = f"axisbind={'+'.join(mods) or 'NONE'},{WHEEL[k]},{cmd}"
                ident = ("axis", tuple(mods), k)
            else:
                line = f"{flag}={'+'.join(mods) or 'NONE'},{kname},{cmd}"
                ident = (tuple(sorted(mods)), kname.lower())
            if ident in seen:
                report["dup"].append(key); continue
            seen.add(ident); lines.append(line); entries.append(entry); report["ported"] += 1
    return lines, report


def gen_env():
    out = [HDR]
    for f in ("settings/apps.kdl", "settings/misc.kdl"):
        for m in re.finditer(r'(?m)^\s*(NIRI_[A-Z_]+)\s+"([^"]*)"', strip_comments((NIRI / f).read_text())):
            out.append(f"env={m.group(1)},{m.group(2)}\n")
    # XDG_CURRENT_DESKTOP stays "mango": session/init.sh and the portals pick by it.
    # greetd starts plain `mango` without a login shell (niri-session uses one), so mango would
    # miss ~/.local/bin, mise, Qt theme, fcitx: every `oq ...` bind and the shell would fail.
    import os, subprocess
    gen = "/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator"
    envd = dict(l.split("=", 1) for l in subprocess.run([gen], capture_output=True, text=True).stdout.splitlines() if "=" in l)
    shell = os.environ.get("SHELL", "/bin/sh")
    home = str(Path.home())
    clean = {"HOME": home, "USER": os.environ.get("USER", ""), "SHELL": shell, "PATH": "/usr/local/bin:/usr/bin:/bin"}  # not our session's PATH
    login = subprocess.run(["env", "-i", *[f"{k}={v}" for k, v in clean.items()], shell, "-l", "-c", 'printf "%s" "$PATH"'],
                           capture_output=True, text=True).stdout.splitlines()
    extra = (login[-1] if login and login[-1].startswith("/") else "").split(":")
    path = envd.get("PATH", "").split(":") + extra  # environment.d first (has ~/.local/bin), like the systemd user manager
    # mango caps a value at 255 bytes: mise/shims already cover mise/installs/*; perl/jvm dirs are rarely needed
    path = list(dict.fromkeys(p for p in path if p and "/mise/installs/" not in p and "perl" not in p and "/jvm/" not in p))
    # `niri` shim (msg -> mmsg) first, so the Omarchy shell and its scripts, which speak `niri msg`, work on mango.
    path.insert(0, str(Path.home() / ".local/share/mango-niri-shim"))
    envd["PATH"] = ":".join(path)
    envd["NIRI_SOCKET"] = "mango-shim"  # the shell's "niri-style compositor" switch; the shim ignores the value
    if len(envd["PATH"]) > 220:
        print(f"WARNING: PATH is {len(envd['PATH'])} bytes, mango limit is 255", file=sys.stderr)
    out.append("# environment.d + login-shell PATH (same as a niri session)\n")
    out += [f"env={k},{v}\n" for k, v in envd.items() if v]
    return "".join(out)


def blocks(text, name):
    """Yield the body of every `name { ... }` block (brace-matched, nested blocks included)."""
    for m in re.finditer(rf'(?m)^\s*{name}\s*\{{', text):
        depth, i = 1, m.end()
        while depth and i < len(text):
            depth += (text[i] == "{") - (text[i] == "}"); i += 1
        yield text[m.end():i - 1]


def gen_rules():
    """niri window-rule { match ...; open-floating ...; } -> mango window_rule lines."""
    out, skipped = [HDR], []
    for f in ("rules/windows.kdl", "dms/windowrules.kdl"):
        path = NIRI / f
        if not path.exists():
            continue
        for body in blocks(strip_comments(path.read_text()), "window-rule"):
            props = []
            if re.search(r'open-floating\s+true', body): props.append("is_floating:1")
            if re.search(r'open-focused\s+false', body): props.append("is_open_silent:1")
            if m := re.search(r'default-column-width\s*\{\s*fixed\s+(\d+)', body): props.append(f"width:{m[1]}")
            if m := re.search(r'default-window-height\s*\{\s*fixed\s+(\d+)', body): props.append(f"height:{m[1]}")
            if re.search(r'(?m)^\s*border\s*\{\s*off', body): props.append("no_border:1")
            if re.search(r'(?m)^\s*shadow\s*\{\s*off', body): props.append("no_shadow:1")
            matches = re.findall(r'(?m)^\s*match\s+(.*)$', body)
            if not props or not matches:
                continue  # nothing mango can do (blur, corner radius, column proportion, ...)
            for mt in matches:
                keys = {"app-id": "app_id", "title": "title"}
                conds = []
                for k, v in re.findall(r'(app-id|title)=((?:r#".*?"#)|(?:"[^"]*"))', mt):
                    conds.append(f"{keys[k]}:{next(tokens(v))}")
                if conds:
                    out.append("window_rule=" + ",".join(props + conds) + "\n")
    return "".join(out)


def gen_monitor():
    out = [HDR]
    text = (NIRI / "dms/outputs.kdl").read_text()
    for m in re.finditer(r'output "([^"]+)"\s*\{(.*?)\n\}', text, re.S):
        name, body = m.groups()
        mode = re.search(r'mode "(\d+)x(\d+)@([\d.]+)"', body)
        scale = re.search(r'scale ([\d.]+)', body)
        pos = re.search(r'position x=(-?\d+) y=(-?\d+)', body)
        if not (mode and pos):
            continue
        w, h, r = mode.groups()
        out.append(f"monitor_rule=name:{name},width:{w},height:{h},refresh:{r},x:{pos[1]},y:{pos[2]},scale:{scale[1] if scale else 1},vrr:0,rr:0\n")
    return "".join(out)


def gen_autostart():
    out = ["#!/bin/bash\n", HDR, "# Runs once when mango starts (mango-session also imports the env into systemd).\n"]
    # Plain `mango` login (no mango-session): do what niri-session does, minus the target itself.
    env_import = (
        "systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE\n"
        "dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE\n"
    )
    # Fast login: the visible shell starts first and gets the CPU; heavy programs nobody sees wait a moment.
    units = (
        "# graphical-session.target can't be started by hand: start the units wanted by it (after the shell is up).\n"
        "(sleep 2; for u in ~/.config/systemd/user/graphical-session.target.wants/*; do\n"
        "  systemctl --user start \"$(basename \"$u\")\" &\n"
        "done) >/dev/null 2>&1 &\n"
    )
    # Login managers hand mango different PATHs (greetd: bare, ly: zsh login, no ~/.local/bin) and mango applies
    # env.conf only to later spawns, so load it here: `oq` and the shim must resolve for the first line.
    out.append(
        "while IFS= read -r l; do\n"
        "  [[ $l == env=* ]] || continue\n"
        "  l=${l#env=}; export \"${l%%,*}=${l#*,}\"\n"
        "done < \"$HOME/.config/mango/env.conf\"\n")
    first, normal, late = [], [], []
    text = strip_comments((NIRI / "settings/startup.kdl").read_text())
    for m in re.finditer(r'(?m)^\s*(spawn-at-startup|spawn-sh-at-startup)\s+(.*?)\s*$', text):
        kind, rest = m.groups()
        t = list(tokens(rest))
        if "niri/scripts/" in rest:
            out.append(f"# skipped (niri-only): {rest}\n"); continue
        cmd = t[0] if kind == "spawn-sh-at-startup" else tilde_join(t)
        if "launch-shell" in cmd:  # the bar, wallpaper and menu: what the eye waits for
            first.append(f"({cmd}) >/dev/null 2>&1 &\n")
        elif "rembrowser" in cmd:  # browser engine warm-up is CPU heavy and invisible
            late.append(f"(sleep 3; {cmd}) >/dev/null 2>&1 &\n")
        else:
            normal.append(f"({cmd}) >/dev/null 2>&1 &\n")
    return "".join(out + first + [env_import] + normal + [units] + late)


def main():
    write = "--write" in sys.argv
    lines, rep = parse_binds(write)
    tail = MANGO / "bind.tail.conf"  # hand-written extras (mouse binds, gestures) kept outside the generated file
    bind_conf = HDR + "\n".join(lines) + "\n" + (tail.read_text() if tail.exists() else "")
    width = max((len(e[0]) for e in rep["entries"]), default=0) + 2
    tsv = "".join(f"{k:<{width}}{t}\t{c}\n" for k, t, c in rep["entries"])  # Mod+F1 list (mango-keybinds)
    files = {"keybinds.tsv": tsv, "bind.conf": bind_conf, "env.conf": gen_env(), "monitor.conf": gen_monitor(), "rules.conf": gen_rules(), "autostart.sh": gen_autostart()}
    print(f"binds ported: {rep['ported']}   duplicates dropped: {len(rep['dup'])}   skipped: {len(rep['skipped'])}")
    for k, why in rep["skipped"]:
        print(f"  skip {k:28} {why}")
    if not write:
        print("\n(dry run; use --write)"); return
    for name, body in files.items():
        p = MANGO / name
        if p.exists():
            (MANGO / (name + ".prev")).write_text(p.read_text())
        p.write_text(body)
        if name.endswith(".sh"):
            p.chmod(0o755)
    print("written:", ", ".join(files))


if __name__ == "__main__":
    main()
