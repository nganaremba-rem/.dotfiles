{
  "layer": "top",
  "position": "top",
  // "output": "",
  "height": 26,
  // "mode": "dock",
  "reload_style_on_change": true,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["custom/launcher", "clock", "memory", "cpu", "temperature"],
  "modules-center": ["niri/workspaces", "hyprland/workspaces"],
  "modules-right": [
    "custom/weather",
    "network",
    "bluetooth",
    "custom/mic",
    "custom/camera",
    "pulseaudio",
    "battery",
    "tray",
    "custom/notifications"
  ],
  "custom/launcher": {
    // "format": "",
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "clock": {
    "interval": 1,
    "format": "{:%H:%M %a %d %b}",
    "on-click": "gsimplecal",
    "tooltip": true,
    "tooltip-format": "<tt><span size='x-large'>{calendar}</span></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span background='#ff6699' color='#1c222a'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/weather": {
    "format": "󰖙",
    "tooltip": false,
    "on-click": "mousam"
  },
  // "network": {
  //   "format-wifi": " {signalStrength}%",
  //   "format-ethernet": "󰈀 Ethernet",
  //   "format-disconnected": "󰖪 Offline",
  //   "tooltip-format": "{essid}",
  //   "on-click": "networkmanager_dmenu"
  // },
  "network": {
    "format-wifi": " {ipaddr} ⏬ {bandwidthDownBytes} ⏫ {bandwidthUpBytes}",
    "format-ethernet": "󰈀 {ipaddr}/{cidr} ⏬ {bandwidthDownBytes} ⏫ {bandwidthUpBytes}",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "format-alt": "{ifname} {ipaddr}/{cidr} ⏬ {bandwidthDownBytes} ⏫ {bandwidthUpBytes}",
    "speed-text-basis": 1024,
    "format-icons": {
      "wired": "wired",
      "wireless": "wifi"
    },
    // "on-click": "networkmanager_dmenu"
    // "on-click": "footclient -e impala"
    // "on-click": "footclient -e gazelle"
    "on-click": "footclient -e wlctl"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "󰝟 Muted",
    "on-click": "footclient -e wiremix"
  },
  "battery": {
    "format": " {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": ["", "", "", "", ""],
    "format-charging": "⚡  {capacity}%",
    "format-plugged": "⚡  {capacity}%"
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {device_battery_percentage}%",
    "tooltip": true,
    "on-click": "footclient -e bluetui"
  },
  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic-status.sh",
    "interval": 3,
    "return-type": "json",
    "signal": 8,
    "on-click": "/home/rem/.local/bin/mic-toggle",
    "tooltip": true
  },
  "custom/camera": {
    "exec": "~/.config/waybar/scripts/camera-status.sh",
    "interval": 3,
    "return-type": "json",
    "signal": 9,
    "on-click": "/home/rem/.local/bin/camera-toggle",
    "tooltip": true
  },
  "custom/notifications": {
    "format": "",
    "tooltip": false,
    "on-click": "swaync-client -t"
  },
  "tray": {
    "spacing": 6
  },
  "memory": {
    "interval": 2,
    "format": "󰘚 {used:0.1f}G | Swap {swapUsed:0.1f}G"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },
  "temperature": {
    "interval": 2,
    "format": " {temperatureC}°C",
    "critical-threshold": 80
  }
}
