diff --git a/niri/rebrand b/niri/rebrand
new file mode 100755
index 0000000..16dee9c
--- /dev/null
+++ b/niri/rebrand
@@ -0,0 +1,20 @@
+#!/bin/bash
+
+# Local branding: this desktop presents itself as Arch. Rewrites the upstream
+# product name in text a person sees (notifications, on-screen display,
+# terminal messages, plugin names). Internal names stay: command names, paths
+# and identifiers must keep matching upstream. Safe to run again after pulling
+# upstream changes.
+
+cd "$OMARCHY_PATH" || exit 1
+
+# Scripts: only lines that print or notify, never comments.
+rg -l 'Omarchy' bin | xargs -r sed -i -E \
+  '/^\s*#/!{/(notification-send|omarchy-osd|notify-send|echo|printf|gum |--who=)/s/\bOmarchy\b/Arch/g}'
+
+# Plugin manifests: names, authors and descriptions shown in plugin lists.
+fd -e json manifest shell | xargs -r sed -i -E 's/\bOmarchy\b/Arch/g'
+
+# Shell: quoted text only.
+rg -l '"[^"]*\bOmarchy\b[^"]*"' shell -g '*.qml' | xargs -r sed -i -E \
+  '/^\s*\/\//!s/("[^"]*)\bOmarchy\b([^"]*")/\1Arch\2/g'
