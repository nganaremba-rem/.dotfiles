{
  // Local changes to the menu, merged over the shipped definition by id.
  // An overriding row replaces every field, so rows are restated in full.
  //
  // Fields: icon, label, action (bash), when (hide when it fails),
  // checked (✓ when it succeeds), disabled (dim when it succeeds).
  // Comments must be whole lines.

  // Pointed at niri and this machine
  "about": {"icon":"","label":"About","action":"omarchy-launch-floating-terminal-with-presentation 'fastfetch --logo arch'"},
  "update.omarchy": {"icon":"","iconFont":"","label":"System","action":"omarchy-launch-floating-terminal-with-presentation 'yay -Syu'"},
  "style.hyprland": {"icon":"","label":"Niri","action":"omarchy-launch-config-editor \"$HOME/.config/niri/settings/layout.kdl\""},
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"omarchy-launch-config-editor \"$HOME/.config/niri/dms/outputs.kdl\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"","action":"omarchy-launch-config-editor \"$HOME/.config/niri/binds\""},
  "setup.input": {"icon":"","label":"Input","when":"","action":"omarchy-launch-config-editor \"$HOME/.config/niri/settings/input.kdl\""},
  "setup.config.hyprland": {"icon":"","label":"Niri","action":"omarchy-launch-config-editor \"$HOME/.config/niri/config.kdl\""},

  // Wallpaper: pick from ~/Pictures/wallpapers (grid, type to filter)
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"wallpaper-pick"},

  // Icon picker: every Nerd Font glyph, same grid as the emoji picker
  "trigger.icons": {"icon":"󰠱","label":"Icons","description":"nerd font glyph symbol picker","action":"omarchy-shell shell summon omarchy.emojis '{\"set\":\"icons\"}'"},

  // Panel switch
  "trigger.appearance.panel": {"icon":"󰍜","label":"Panel"},
  "trigger.appearance.panel.dms": {"icon":"󰈈","label":"DMS Panel","checked":"[[ $(panel-mode) == dms ]]","action":"panel-switch dms"},
  "trigger.appearance.panel.shell": {"icon":"󰈈","label":"Shell Panel","checked":"[[ $(panel-mode) == shell ]]","action":"panel-switch shell"},

  // Hidden: needs Hyprland or the upstream distro, or not wanted here
  "learn": {"icon":"󰧑","label":"Learn","when":"false"},
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omarchy-launch-screensaver force","when":"false"},
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"omarchy-menu-keybindings","when":"false"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"omarchy-launch-webapp 'https://omarchy.org/manual/'","when":"false"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-webapp 'https://wiki.hypr.land/'","when":"false"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"omarchy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'","when":"false"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"omarchy-launch-webapp 'https://www.lazyvim.org/keymaps'","when":"false"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"omarchy-launch-webapp 'https://devhints.io/bash'","when":"false"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"omarchy-menu-tmux-keybindings","when":"false"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"omarchy-menu-herdr-keybindings","when":"false"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"omarchy-launch-discord-community","when":"false"},
  "trigger.appearance.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"omarchy-hyprland-window-single-square-aspect-toggle","when":"false"},
  "trigger.appearance.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","title":"Default Workspace Layout","when":"false"},
  "trigger.appearance.workspace-layout.dwindle": {"icon":"󱓻","label":"Tiling","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == \"dwindle\" ]]","action":"omarchy-hyprland-workspace-layout-default dwindle","when":"false"},
  "trigger.appearance.workspace-layout.scrolling": {"icon":"󰝥","label":"Scrolling","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == \"scrolling\" ]]","action":"omarchy-hyprland-workspace-layout-default scrolling","when":"false"},
  "trigger.appearance.workspace-layout.floating": {"icon":"󰔶","label":"Floating","checked":"[[ $(omarchy-hyprland-workspace-layout-default) == \"floating\" ]]","action":"omarchy-hyprland-workspace-layout-default floating","when":"false"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"omarchy-toggle-screensaver","when":"false"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Mirror Display","when":"false","action":"omarchy-hyprland-monitor-internal-mirror toggle"},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(omarchy-plymouth-switcher); if [[ $unlock == default ]]; then omarchy-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then omarchy-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi","when":"false"},
  "style.font": {"icon":"","label":"Font","provider":"fonts","when":"false"},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver","when":"false"},
  "style.about": {"icon":"","label":"About","when":"false"},
  "style.about.text": {"icon":"","label":"Edit Text","action":"omarchy-branding-about text","when":"false"},
  "style.about.image": {"icon":"","label":"Set From Image","action":"omarchy-branding-about image","when":"false"},
  "style.about.default": {"icon":"","label":"Restore Default","action":"omarchy-branding-about reset","when":"false"},
  "style.screensaver.text": {"icon":"","label":"Edit Text","action":"omarchy-branding-screensaver text","when":"false"},
  "style.screensaver.image": {"icon":"","label":"Set From Image","action":"omarchy-branding-screensaver image","when":"false"},
  "style.screensaver.default": {"icon":"","label":"Restore Default","action":"omarchy-branding-screensaver reset","when":"false"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"],"when":"false"},
  "setup.plugin.enable": {"icon":"󰄬","label":"Enable Plugin","action":"omarchy-menu-plugin enable","when":"false"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Disable Plugin","action":"omarchy-menu-plugin disable","when":"false"},
  "setup.plugin.add": {"icon":"󰖟","label":"Add Plugin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-plugin-add'","when":"false"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Clone Plugin","action":"omarchy-menu-plugin clone","when":"false"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Remove Plugin","when":"false","action":"omarchy-menu-plugin remove"},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omarchy-launch-config-editor ~/.config/hypr/hyprsunset.conf && omarchy-restart-hyprsunset","when":"false"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","when":"false","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Reset Computer","when":"false","action":"omarchy-launch-floating-terminal-with-presentation omarchy-system-factory-reset"},
  "update.channel": {"icon":"󰔫","label":"Channel","when":"false"},
  "update.channel.stable": {"icon":"🟢","label":"Stable","checked":"[[ \"$(omarchy-channel-current)\" == \"stable\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-channel-set stable'","when":"false"},
  "update.channel.rc": {"icon":"🟡","label":"RC","checked":"[[ \"$(omarchy-channel-current)\" == \"rc\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-channel-set rc'","when":"false"},
  "update.channel.edge": {"icon":"🟠","label":"Edge","checked":"[[ \"$(omarchy-channel-current)\" == \"edge\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-channel-set edge'","when":"false"},
  "update.channel.dev": {"icon":"🔴","label":"Dev","checked":"[[ \"$(omarchy-channel-current)\" == \"dev\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-channel-set dev'","when":"false"},
  "update.process.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omarchy-restart-hyprsunset","when":"false"},
  "update.config.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-floating-terminal-with-presentation omarchy-refresh-hyprland","when":"false"},
  "update.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omarchy-launch-floating-terminal-with-presentation omarchy-refresh-hyprsunset","when":"false"},
  "update.config.plymouth": {"icon":"󱣴","label":"Plymouth","action":"omarchy-launch-floating-terminal-with-presentation omarchy-refresh-plymouth","when":"false"},
}
