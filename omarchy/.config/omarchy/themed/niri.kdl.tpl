// Generated from the active theme: niri border and focus colours.
// Copied to ~/.config/niri/theme.kdl while the shell panel is in use.
layout {
    focus-ring {
        active-color "{{ accent }}"
        inactive-color "{{ muted }}"
    }
    border {
        active-color "{{ accent }}"
        inactive-color "{{ muted }}"
    }
    tab-indicator {
        active-color "{{ accent }}"
        inactive-color "{{ muted }}"
    }
    insert-hint {
        color "{{ accent }}80"
    }
}
