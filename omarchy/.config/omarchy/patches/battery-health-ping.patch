diff --git a/bin/omarchy-battery-status b/bin/omarchy-battery-status
index 13de445..025ca65 100755
--- a/bin/omarchy-battery-status
+++ b/bin/omarchy-battery-status
@@ -132,6 +132,9 @@ if [[ $shell_output == "true" ]]; then
 
   [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"
 
+  full=$(<"$battery_path/charge_full") design=$(<"$battery_path/charge_full_design")
+  [[ $full =~ ^[0-9]+$ && $design =~ ^[0-9]+$ ]] && (( design > 0 )) && printf 'health\t%s%%\n' $(( full * 100 / design ))
+
   if [[ -n $threshold_end ]]; then
     if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
       printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
