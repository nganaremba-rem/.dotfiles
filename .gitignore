# Secrets — never commit real keys/tokens. Track only the .example template.
zsh/.config/zsh/secrets.zsh
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/release-notes.json
*.bak*
*-bak*
__pycache__/
# DankMaterialShell: whole dir is stowed (DMS rewrites its settings), track only these
dms/.config/DankMaterialShell/*
!dms/.config/DankMaterialShell/settings.json
!dms/.config/DankMaterialShell/plugins.lock.json
# atac: only keybindings are config; collections/logs stay local
atac/.config/atac/*
!atac/.config/atac/vim_key_bindings.toml
# qt5ct/qt6ct matugen palettes are regenerated by DMS on every theme change
qt/.config/qt5ct/colors/matugen.conf
qt/.config/qt6ct/colors/matugen.conf
# Folder shortcuts of the file manager name private project folders
gtk/.config/gtk-3.0/bookmarks
# espanso matches hold passwords; never add ~/.config/espanso here
# The DuckDNS token lives in /usr/local/bin/ddns-update.sh; only the template is tracked
setup/system/files/usr/local/bin/ddns-update.sh
