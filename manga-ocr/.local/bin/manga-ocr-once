#!/home/rem/.local/share/pipx/venvs/manga-ocr/bin/python
# OCR client — sends image path to the daemon and prints the result.
# Falls back to loading the model directly if the daemon isn't running.
import sys
import os
import socket

SOCKET_PATH = "/tmp/manga-ocr.sock"

if len(sys.argv) != 2:
    print("Usage: manga-ocr-once <image>", file=sys.stderr)
    sys.exit(1)

img_path = sys.argv[1]

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(10)
    s.connect(SOCKET_PATH)
    s.sendall(img_path.encode())
    s.shutdown(socket.SHUT_WR)
    result = b""
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        result += chunk
    s.close()
    print(result.decode().strip())
except (FileNotFoundError, ConnectionRefusedError):
    # Daemon not running — fall back to direct inference
    import logging, warnings
    logging.disable(logging.CRITICAL)
    warnings.filterwarnings("ignore")
    os.environ["TRANSFORMERS_VERBOSITY"] = "error"
    from manga_ocr import MangaOcr
    print(MangaOcr()(img_path))
