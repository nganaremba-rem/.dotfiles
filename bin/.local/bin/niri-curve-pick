#!/bin/bash

ANIM_FILE="$HOME/.config/niri/animations.kdl"

declare -A CURVES=(
  ["ease-out-quad"]='curve "ease-out-quad"'
  ["ease-out-cubic"]='curve "ease-out-cubic"'
  ["ease-out-expo"]='curve "ease-out-expo"'
  ["linear"]='curve "linear"'
  ["cubic-bezier: current (smooth fast)"]='curve "cubic-bezier" 0.05 0.7 0.1 1.0'
  ["cubic-bezier: iOS/macOS spring"]='curve "cubic-bezier" 0.34 1.56 0.64 1.0'
  ["cubic-bezier: Material Design"]='curve "cubic-bezier" 0.2 0.0 0.0 1.0'
  ["cubic-bezier: bouncy overshoot"]='curve "cubic-bezier" 0.68 -0.55 0.27 1.55'
  ["cubic-bezier: snappy pop"]='curve "cubic-bezier" 0.0 0.9 0.1 1.0'
  ["cubic-bezier: soft land"]='curve "cubic-bezier" 0.25 0.46 0.45 0.94'
)

CHOICE=$(printf '%s\n' "${!CURVES[@]}" | sort | rofi -dmenu -p "window-open curve" -i)

[[ -z "$CHOICE" ]] && exit 0

CURVE_VALUE="${CURVES[$CHOICE]}"

# Replace the curve line inside the window-open block only
sed -i "/window-open/,/}/ s|.*curve.*|        $CURVE_VALUE|" "$ANIM_FILE"

notify-send "niri curve" "$CHOICE" --expire-time=2000
