#!/usr/bin/env bash
# Bar command-widget readings as waybar-style JSON.  bar-status wg|ts|docker
set -uo pipefail

json() { # text color tooltip
  jq -nc --arg t "$1" --arg c "$2" --arg tt "$3" '{text:$t,color:$c,tooltip:$tt}'
}

wg_status() {
  # "Connected" = the peer sent traffic recently. The handshake time alone lags: it is only
  # refreshed every ~2 min, so a dropped peer would look connected for up to 3 minutes.
  # Phones send a keepalive every 25 s, so 75 s without new rx bytes means gone.
  local now key rx hs ts ip up=0 total=0 lines="" ips tr state chg
  local -A prev_rx prev_chg handshake
  state=${XDG_RUNTIME_DIR:-/tmp}/bar-wg-rx
  tr=$(sudo -n /usr/bin/wg show wg0 transfer 2>/dev/null) || { json "" grey $'WireGuard wg0: down or no access\n$ sudo wg show wg0'; return; }
  while read -r key ts; do handshake[$key]=$ts; done < <(sudo -n /usr/bin/wg show wg0 latest-handshakes 2>/dev/null)
  ips=$(sudo -n /usr/bin/wg show wg0 allowed-ips 2>/dev/null)
  [ -r "$state" ] && while read -r key rx chg; do prev_rx[$key]=$rx; prev_chg[$key]=$chg; done <"$state"
  now=$(date +%s); : >"$state.new"
  while read -r key rx _; do
    [ -n "$key" ] || continue
    total=$((total + 1))
    hs=${handshake[$key]:-0}
    if [ "${prev_rx[$key]:-}" != "$rx" ]; then chg=$now; [ -z "${prev_rx[$key]:-}" ] && chg=$hs   # first sight: trust handshake age
    else chg=${prev_chg[$key]:-0}; fi
    printf '%s %s %s\n' "$key" "$rx" "$chg" >>"$state.new"
    ip=$(awk -v k="$key" '$1==k{print $2}' <<<"$ips")
    if [ "$chg" -gt 0 ] && [ $((now - chg)) -lt 75 ]; then
      up=$((up + 1)); lines+="● ${ip:-${key:0:6}}  traffic $((now - chg))s ago"$'\n'
    elif [ "$hs" -gt 0 ]; then
      lines+="○ ${ip:-${key:0:6}}  idle $(( (now - hs) / 60 ))m"$'\n'
    else
      lines+="○ ${ip:-${key:0:6}}  never connected"$'\n'
    fi
  done <<<"$tr"
  mv "$state.new" "$state"
  json "" "$([ "$up" -gt 0 ] && echo green || echo grey)" "WireGuard: $up of $total peers connected"$'\n'"${lines}\$ sudo wg show wg0"
}

ts_status() {
  local s state online total
  s=$(tailscale status --json 2>/dev/null) || { json "󱗼" grey $'Tailscale: not running\n$ tailscale status'; return; }
  state=$(jq -r .BackendState <<<"$s")
  online=$(jq '[.Peer[]? | select(.Online)] | length' <<<"$s")
  total=$(jq '[.Peer[]?] | length' <<<"$s")
  json "󱗼" "$([ "$state" = Running ] && [ "$online" -gt 0 ] && echo green || echo grey)" "Tailscale: $state, $online of $total peers online"$'\n$ tailscale status'
}

docker_status() {
  local names n
  names=$(docker ps --format '{{.Names}}  {{.Status}}' 2>/dev/null) || { json "󰡨" grey $'Docker: daemon not reachable\n$ docker ps'; return; }
  n=$(grep -c . <<<"$names" || true)
  json "󰡨" "$([ "$n" -gt 0 ] && echo green || echo grey)" "Docker: $n running"$'\n'"${names}"$'\n$ docker ps'
}

case "${1:-}" in
  wg) wg_status ;; ts) ts_status ;; docker) docker_status ;;
  *) echo "usage: bar-status wg|ts|docker" >&2; exit 2 ;;
esac
