#!/usr/bin/python3
"""Fuzzy tab picker for vimb (vimb has no tab-list API).

Reads the tab titles of the vimb window owning PID over AT-SPI, picks one with
fuzzel, and switches to it over AT-SPI. Must run async (`:sh!`): vimb has to stay
responsive to answer the accessibility queries.

Usage (vimb config):  nnoremap <Space><Space> :sh! vimb-tabs $VIMB_PID<CR>
"""
import json, subprocess, sys, time
import gi
gi.require_version('Atspi', '2.0')
from gi.repository import Atspi


def tab_list(pid):
    desk = Atspi.get_desktop(0)
    for i in range(desk.get_child_count()):
        app = desk.get_child_at_index(i)
        if app and app.get_process_id() == pid:
            stack = [app]
            while stack:
                o = stack.pop()
                if o.get_role_name() == 'page tab list':
                    return o
                stack += [o.get_child_at_index(j) for j in range(o.get_child_count())]
    sys.exit(f'vimb-tabs: no vimb tab list for pid {pid}')


def window_title(pid):
    out = subprocess.run(['niri', 'msg', '-j', 'windows'], capture_output=True, text=True).stdout
    return next((w['title'] for w in json.loads(out or '[]') if w.get('pid') == pid), None)


def main():
    pid = int(sys.argv[1])
    tl = tab_list(pid)
    tabs = [tl.get_child_at_index(i) for i in range(tl.get_child_count())]
    names = [t.get_name() or '(untitled)' for t in tabs]
    cur = next((i for i, t in enumerate(tabs) if t.get_state_set().contains(Atspi.StateType.SELECTED)), -1)

    lines = '\n'.join(f"{i + 1}  {'●' if i == cur else ' '} {n}" for i, n in enumerate(names))
    pick = subprocess.run(['fuzzel', '--dmenu', '--index', '--prompt', 'tabs ❯ ', '--lines', str(min(len(names), 15))],
                          input=lines, capture_output=True, text=True)
    if pick.returncode or not pick.stdout.strip():
        return
    target = int(pick.stdout)

    # GTK4 notebook a11y selection is off by one: select_child(i) shows tab i-1.
    # Confirm through the window title (vimb mirrors the active tab), else try the plain index.
    n, sel = len(tabs), tl.get_selection_iface()
    for idx in ((target + 1) % n, target):
        sel.select_child(idx)
        time.sleep(0.15)
        if window_title(pid) == names[target]:
            return


if __name__ == '__main__':
    main()
