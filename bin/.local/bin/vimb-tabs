#!/usr/bin/python3
"""Fuzzy tab picker for vimb (vimb has no tab-list API).

Reads the tab titles of the vimb window owning PID over AT-SPI, picks one with
fuzzel, and switches to it over AT-SPI. Must run async (`:sh!`): vimb has to stay
responsive to answer the accessibility queries.

Usage (vimb config):  nnoremap <Space><Space> :sh! vimb-tabs $VIMB_PID<CR>
"""
import subprocess, sys
import gi
gi.require_version('Atspi', '2.0')
from gi.repository import Atspi

# Web pages expose their own ARIA tab lists in the same tree; never search inside them.
WEB_CONTENT = {'document web', 'document frame', 'embedded'}


def tab_list(pid):
    """vimb's GtkNotebook tab list (not a tablist on the web page)."""
    desk = Atspi.get_desktop(0)
    for i in range(desk.get_child_count()):
        app = desk.get_child_at_index(i)
        if app and app.get_process_id() == pid:
            stack = [app]
            while stack:
                o = stack.pop()
                if o.get_role_name() == 'page tab list':
                    return o
                stack += [c for j in range(o.get_child_count())
                          if (c := o.get_child_at_index(j)) and c.get_role_name() not in WEB_CONTENT]
    sys.exit(f'vimb-tabs: no vimb tab list for pid {pid}')


def main():
    tl = tab_list(int(sys.argv[1]))
    # Children also include the "Previous tab"/"Next tab" scroll buttons; keep real tabs,
    # remembering their child index — that's what the Selection interface counts.
    tabs = [(j, c) for j in range(tl.get_child_count())
            if (c := tl.get_child_at_index(j)) and c.get_role_name() == 'page tab']
    cur = next((n for n, (_, t) in enumerate(tabs) if t.get_state_set().contains(Atspi.StateType.SELECTED)), -1)

    lines = '\n'.join(f"{n + 1}  {'●' if n == cur else ' '} {t.get_name() or '(untitled)'}"
                      for n, (_, t) in enumerate(tabs))
    pick = subprocess.run(['fuzzel', '--dmenu', '--index', '--prompt', 'tabs ❯ ', '--lines', str(min(len(tabs), 15))],
                          input=lines, capture_output=True, text=True)
    if pick.returncode == 0 and pick.stdout.strip():
        tl.get_selection_iface().select_child(tabs[int(pick.stdout)][0])


if __name__ == '__main__':
    main()
