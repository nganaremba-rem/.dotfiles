#!/usr/bin/env bash
# ytdl-run URL TYPE(video|audio) QUALITY NAME DIR — download with yt-dlp, notify on start/finish.
set -u
url=$1 type=$2 q=$3 name=${4:-} dir=${5:-$HOME/Videos} from=${6:-} to=${7:-}
dir=${dir/#\~/$HOME}
mkdir -p "$dir" || exit 1
tmpl=${name:-%(title)s}
args=(--no-playlist --newline --embed-metadata -P "$dir" -o "$tmpl.%(ext)s" --quiet --progress --progress-template "download:PROG|%(progress._percent_str)s|%(progress._speed_str)s|%(progress._eta_str)s" --print after_move:filepath --print 'before_dl:META|%(title)s')
if [[ -n $from || -n $to ]]; then  # section: "*FROM-TO", blank end = to the end
  args+=(--download-sections "*${from:-0}-${to:-inf}" --force-keyframes-at-cuts)
fi
if [[ $type == audio ]]; then
  args+=(-x --audio-format "$q" --embed-thumbnail)
elif [[ $q == best ]]; then
  args+=(-S "ext:mp4:m4a")
else
  args+=(-S "res:${q%p},ext:mp4:m4a")
fi
log=${YTDL_LOG:-/dev/stdout}
[[ $log == /dev/stdout ]] || echo $$ >"$log.pid"
exec 3>>"$log"
[[ $log == /dev/stdout ]] || echo "META|${name:-$url}" >&3
id=$(oq omarchy-notification-send --app-name ytdl -g 󰇚 -p -t 0 "Downloading" "$type · $q · click: progress" --exec omarchy-shell -q shell summon omarchy.notifications "{}")
trap 'pkill -P $$; exit 130' TERM INT
# site key from the URL -> its own cookie file ~/.config/ytdl/cookies/<site>.txt (dir 700, files 600;
# the downloader's own jar, separate from remtube). yt-dlp only sends cookies whose domain matches the URL.
site_of() {
  local h=${1#*://} p n
  h=${h%%[/:?#]*}; h=${h,,}; h=${h#www.}
  case $h in
    youtu.be|youtube.com|*.youtube.com|youtube-nocookie.com) echo youtube; return ;;
    fb.watch|fb.com|facebook.com|*.facebook.com) echo facebook; return ;;
    x.com|*.x.com|twitter.com|*.twitter.com) echo x; return ;;
  esac
  IFS=. read -ra p <<<"$h"; n=${#p[@]}
  if ((n >= 3)) && [[ ${p[n-2]} =~ ^(co|com|org|net|gov|ac)$ && ${#p[n-1]} -eq 2 ]]; then echo "${p[n-3]//[^a-z0-9-]/}"
  elif ((n >= 2)); then echo "${p[n-2]//[^a-z0-9-]/}"; else echo "${h//[^a-z0-9-]/}"; fi
}
site=$(site_of "$url")
mkdir -p -m 700 "$HOME/.config/ytdl/cookies"
cookies=${YTDL_COOKIES:-$HOME/.config/ytdl/cookies/$site.txt}
# errors that mean "this needs a (new) login"; a bare 403 only counts on YouTube (elsewhere it is often geo/CDN)
needs_login='Sign in|sign in|cookies are no longer valid|--cookies|[Ll]og ?in|[Aa]uthenticat|registered users|rate-limit'
[[ $site == youtube ]] && needs_login+='|HTTP Error 403'
run_dl() { PYTHONUNBUFFERED=1 yt-dlp "$@" -- "$url" 2>&1 | tee >(rg --line-buffered -N '^(PROG|META)' >&3) | rg -v '^(PROG|META)'; }
all=$(run_dl "${args[@]}"); out=$(tail -n1 <<<"$all")
# the site wants a login: retry once with that site's cookies (a throwaway copy, yt-dlp rewrites its jar)
if [[ ! -f $out && $all =~ $needs_login && -r $cookies ]]; then
  ck=$(mktemp); cp "$cookies" "$ck"
  all=$(run_dl --cookies "$ck" "${args[@]}"); out=$(tail -n1 <<<"$all"); rm -f "$ck"
fi
if [[ -f $out ]]; then
  echo "FILE|$out" >&3; echo DONE >&3
  oq omarchy-notification-send --app-name ytdl -g 󰄬 -r "$id" -t 10000 "Download complete" "${out##*/} · right-click: folder" --exec ytdl-open "$out"
else
  err=$(rg -N '^ERROR' <<<"$all" | tail -n1 | sed 's/^ERROR: *//; s/^\[[a-z:A-Z0-9]*\] [^:]*: //' | cut -c1-200)
  if [[ $all =~ $needs_login ]]; then
    # the site wants a login and ours is missing or no longer works: tell the user how to refresh it
    [[ -r $cookies ]] && why="expired" || why="missing"
    echo "COOKIES|$why|$site|${cookies/#$HOME/\~}" >&3
    echo "ERR|$site cookies $why — export new ones (steps in the popup)" >&3; echo FAIL >&3
    oq omarchy-notification-send --app-name ytdl -g 󰀪 -u critical -r "$id" "Update your $site cookies ($why)" "Private Helium window → log in to $site → cookie exporter (on that tab) → save as ${cookies/#$HOME/\~}, close the window. Then retry."
  else
    echo "ERR|${err:-unknown error}" >&3; echo FAIL >&3
    oq omarchy-notification-send --app-name ytdl -g 󰅖 -u critical -r "$id" "Download failed" "${err:-unknown error}"
  fi
fi
