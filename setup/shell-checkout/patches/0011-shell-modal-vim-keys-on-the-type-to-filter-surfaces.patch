diff --git a/shell/Ui/OverlayWindow.qml b/shell/Ui/OverlayWindow.qml
index 52868c5..13b9233 100644
--- a/shell/Ui/OverlayWindow.qml
+++ b/shell/Ui/OverlayWindow.qml
@@ -3,6 +3,7 @@ import Quickshell
 import Quickshell.Hyprland
 import Quickshell.Wayland
 import qs.Commons
+import qs.Commons as Commons
 
 // Map a fresh fullscreen surface on each open. Keep its first frames
 // transparent until Qt receives the output's scale, so it opens sharp without
@@ -57,6 +58,7 @@ PanelWindow {
   // Live monitor scaling does not emit a Hyprland monitor event, so its cached
   // scale can lag behind Qt. Refresh on opening and on scale changes while open.
   onShownChanged: {
+    if (shown) Vim.reset()
     targetScreen = shown ? focusedScreen() : null
     if (shown && !Niri.active) Hyprland.refreshMonitors()
   }
@@ -86,6 +88,29 @@ PanelWindow {
 
   // Opacity preserves keyboard handling while the scale arrives, including
   // search keystrokes and Escape pressed immediately after opening.
+  // niri port: say so when keys navigate instead of type (see Commons/Vim.qml).
+  Rectangle {
+    visible: Vim.normal && window.shown
+    anchors.horizontalCenter: parent.horizontalCenter
+    anchors.bottom: parent.bottom
+    anchors.bottomMargin: Style.space(40)
+    width: modeHint.implicitWidth + Style.space(24)
+    height: modeHint.implicitHeight + Style.space(12)
+    radius: Style.cornerRadius
+    color: Commons.Color.background
+    border.width: 1
+    border.color: Commons.Color.accent
+
+    Text {
+      id: modeHint
+      anchors.centerIn: parent
+      text: "NORMAL   h j k l move   i type   Esc close"
+      color: Commons.Color.foreground
+      font.family: Style.font.family
+      font.pixelSize: Style.font.bodySmall
+    }
+  }
+
   Binding {
     target: window.contentItem
     property: "opacity"
diff --git a/shell/plugins/clipboard/Clipboard.qml b/shell/plugins/clipboard/Clipboard.qml
index b6fb9f9..ea09318 100644
--- a/shell/plugins/clipboard/Clipboard.qml
+++ b/shell/plugins/clipboard/Clipboard.qml
@@ -352,6 +352,9 @@ Item {
             return
           }
 
+          event = Vim.translate(event, function() { root.close() })
+          if (!event) return
+
           if (event.key === Qt.Key_Escape) {
             if (root.filterText) root.setFilter("")
             else root.close()
