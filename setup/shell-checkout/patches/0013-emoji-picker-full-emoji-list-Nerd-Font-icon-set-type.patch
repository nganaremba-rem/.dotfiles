@@ -20,6 +20,13 @@ Item {
   property bool cursorActive: false
   property var emojis: []
   property var filteredEmojis: []
+  // niri port: one picker, two data files. "emojis" is every emoji, "icons" is
+  // every Nerd Font glyph; open with {"set":"icons"} for the second.
+  property string dataSet: "emojis"
+  readonly property string selectedName: {
+    var row = cursorActive ? filteredEmojis[selectedIndex] : null
+    return row ? String(row.n || "") : ""
+  }
 
   // Shares the [menu] surface tokens — themes that style the menu also
   // style emojis. Selected-cell colors composed in the
@@ -44,6 +51,9 @@ Item {
   property int columns: Math.floor((cardWidth - contentMargin * 2) / cellWidth)
 
   function open(payloadJson) {
+    var payload = {}
+    try { payload = JSON.parse(payloadJson || "{}") || {} } catch (e) {}
+    root.dataSet = payload.set === "icons" ? "icons" : "emojis"
     root.opened = true
     root.filterText = ""
     root.selectedIndex = 0
@@ -73,7 +83,7 @@ Item {
   }
 
   function rebuildDisplay() {
-    var out = EmojiSearch.filterEmojis(root.emojis, root.filterText, 1000)
+    var out = EmojiSearch.filterEmojis(root.emojis, root.filterText, 20000)
     root.filteredEmojis = out
 
     displayModel.clear()
@@ -155,7 +165,7 @@ Item {
   ListModel { id: displayModel }
 
   FileView {
-    path: root.omarchyPath + "/shell/plugins/emojis/emojis.json"
+    path: root.omarchyPath + "/shell/plugins/emojis/" + root.dataSet + ".json"
     onLoaded: root.loadEmojis(text())
   }
   OverlayWindow {
@@ -246,16 +256,33 @@ Item {
 
           Text {
             textFormat: Text.PlainText
+            id: filterLabel
             anchors.left: parent.left
-            anchors.right: parent.right
+            anchors.right: selectedLabel.left
+            anchors.rightMargin: Style.spacing.md
             anchors.verticalCenter: parent.verticalCenter
-            text: root.filterText || "Search emojis…"
+            text: root.filterText || (root.dataSet === "icons" ? "Search icons…" : "Search emojis…")
             color: root.foreground
             opacity: root.filterText ? 1 : 0.58
             font.family: root.fontFamily
             font.pixelSize: Style.font.heading
             elide: Text.ElideRight
           }
+
+          // Name of the highlighted item, so an icon can be told from its neighbours.
+          Text {
+            id: selectedLabel
+            textFormat: Text.PlainText
+            anchors.right: parent.right
+            anchors.verticalCenter: parent.verticalCenter
+            width: Math.min(implicitWidth, parent.width * 0.6)
+            text: root.selectedName
+            color: root.foreground
+            opacity: 0.58
+            font.family: root.fontFamily
+            font.pixelSize: Style.font.bodySmall
+            elide: Text.ElideRight
+          }
         }
 
         Item {
@@ -285,6 +312,8 @@ Item {
               Text {
                 textFormat: Text.PlainText
                 text: parent.emoji
+                // Emoji bring their own colours; icon glyphs need one.
+                color: hasCursor ? root.selectedText : root.foreground
                 font.family: root.fontFamily
                 font.pixelSize: Style.font.display
                 anchors.centerIn: parent
