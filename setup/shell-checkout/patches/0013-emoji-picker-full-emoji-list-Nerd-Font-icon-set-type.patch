From 3f363acf2caf99df5dd3cd9064e529da159e0abf Mon Sep 17 00:00:00 2001
From: nganaremba-rem <ngancloverr+remkugithub@gmail.com>
Date: Sun, 11 Oct 2026 22:01:20 +0530
Subject: [PATCH 13/23] emoji picker: full emoji list, Nerd Font icon set, type
 the glyph directly

The picker showed at most 1000 of a 1870-emoji subset. niri/gen-pickers now
builds the full list (5042, from rofi-emoji's data) and a second data file
with every Nerd Font glyph in the shell font (10610); {"set":"icons"} opens
the second. The header names the highlighted item.

Selecting typed the wrong text: the insert script copied the emoji and
pressed Shift+Insert, which here pastes the primary selection. It now types
the glyph with wtype.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bin/omarchy-menu-emoji-insert    | 12 +++----
 niri/gen-pickers                 | 55 ++++++++++++++++++++++++++++++++
 shell/plugins/emojis/Emojis.qml  | 37 ++++++++++++++++++---
 shell/plugins/emojis/emojis.json |  2 +-
 shell/plugins/emojis/icons.json  |  1 +
 5 files changed, 94 insertions(+), 13 deletions(-)
 create mode 100755 niri/gen-pickers
 create mode 100644 shell/plugins/emojis/icons.json

diff --git a/bin/omarchy-menu-emoji-insert b/bin/omarchy-menu-emoji-insert
index 583702e..92cf4fd 100755
--- a/bin/omarchy-menu-emoji-insert
+++ b/bin/omarchy-menu-emoji-insert
@@ -6,15 +6,11 @@
 # omarchy:hidden=true
 
 emoji="${1:-}"
-copy_pid=""
 
 [[ -n $emoji ]] || exit
 
-printf '%s' "$emoji" | wl-copy --type text/plain --sensitive --foreground &
-copy_pid=$!
-
+# niri port: type the glyph itself. Upstream copies it and presses Shift+Insert,
+# which on this desktop pastes the primary selection (the last text selected
+# with the mouse) instead of the clipboard.
 sleep 0.15
-wtype -M shift -k Insert -m shift 2>/dev/null || true
-sleep 0.2
-
-kill "$copy_pid" 2>/dev/null || true
+wtype -- "$emoji"
diff --git a/niri/gen-pickers b/niri/gen-pickers
new file mode 100755
index 0000000..48f927a
--- /dev/null
+++ b/niri/gen-pickers
@@ -0,0 +1,55 @@
+#!/usr/bin/env -S uv run --quiet --with fonttools python
+"""Regenerate the data files of the emoji and icon pickers.
+
+  emojis.json  every emoji, from the list rofi-emoji ships (Unicode's full set,
+               skin tones included); upstream's file is a 1870-entry subset.
+  icons.json   every Nerd Font glyph in the shell's font, named as the font
+               names it ("md-monitor_share").
+
+Rows are {e: glyph, n: name, k: lowercase search text}. Run again after
+pulling upstream or updating the font: niri/gen-pickers
+"""
+import json
+import pathlib
+import subprocess
+
+from fontTools.ttLib import TTFont
+
+HERE = pathlib.Path(__file__).resolve().parent.parent / "shell/plugins/emojis"
+EMOJI_LIST = pathlib.Path("/usr/share/rofi-emoji/all_emojis.txt")
+
+
+def write(name, rows):
+    (HERE / name).write_text(json.dumps(rows, ensure_ascii=False, separators=(",", ":")) + "\n")
+    print(f"{name}: {len(rows)} rows")
+
+
+def emojis():
+    rows = []
+    for line in EMOJI_LIST.read_text().splitlines():
+        emoji, group, subgroup, name, keywords = (line.split("\t") + [""] * 5)[:5]
+        if not emoji:
+            continue
+        words = f"{name} {keywords.replace('|', ' ')} {subgroup.replace('-', ' ')} {group}"
+        rows.append({"e": emoji, "n": name, "k": " ".join(words.lower().split())})
+    return rows
+
+
+def icons():
+    family = subprocess.run(["fc-match", "-f", "%{file}", "monospace"], capture_output=True, text=True, check=True).stdout
+    cmap = TTFont(family, fontNumber=0).getBestCmap()
+    rows = []
+    for codepoint, name in sorted(cmap.items()):
+        # Private Use Area only: that is where Nerd Fonts keeps its icons.
+        if not (0xE000 <= codepoint <= 0xF8FF or codepoint >= 0xF0000):
+            continue
+        rows.append({"e": chr(codepoint), "n": name, "k": f"{name} {name.replace('-', ' ').replace('_', ' ')}".lower()})
+    return rows
+
+
+if __name__ == "__main__":
+    write("emojis.json", emojis())
+    write("icons.json", icons())
+    # The smallest thing that fails if a source changed shape.
+    assert any(r["e"] == "😀" and "grinning" in r["k"] for r in json.loads((HERE / "emojis.json").read_text()))
+    assert any(r["n"] == "md-monitor_share" for r in json.loads((HERE / "icons.json").read_text()))
