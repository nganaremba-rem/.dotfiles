+#!/bin/bash
+
+# niri stand-in: a theme restyles this shell and niri's borders only. Terminals,
+# editors, GTK and the browser keep their own colours, and with the DMS panel
+# running the wallpaper stays DMS's.
+
+export OMARCHY_THEME_APPS=off
+if [[ $(panel-mode) == "dms" ]]; then
+  export OMARCHY_THEME_SKIP_BACKGROUND=1
+fi
+
+exec "$OMARCHY_PATH/bin/omarchy-theme-set" "$@"
