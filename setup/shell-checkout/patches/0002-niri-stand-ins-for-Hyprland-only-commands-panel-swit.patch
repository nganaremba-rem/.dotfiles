diff --git a/niri/bin/omarchy-pkg-add b/niri/bin/omarchy-pkg-add
new file mode 100755
index 0000000..a51ee6c
--- /dev/null
+++ b/niri/bin/omarchy-pkg-add
@@ -0,0 +1,29 @@
+#!/bin/bash
+
+# niri stand-in: this machine has no extra package repo, so anything pacman's
+# sync databases do not carry is taken from the AUR instead.
+
+repo=() aur=()
+for pkg in "$@"; do
+  if pacman -Q -- "$pkg" &>/dev/null; then
+    continue
+  elif pacman -Si -- "$pkg" &>/dev/null; then
+    repo+=("$pkg")
+  else
+    aur+=("$pkg")
+  fi
+done
+
+if (( ${#repo[@]} > 0 )); then
+  sudo pacman -S --noconfirm --needed -- "${repo[@]}" || exit 1
+fi
+if (( ${#aur[@]} > 0 )); then
+  yay -S --needed -- "${aur[@]}" || exit 1
+fi
+
+for pkg in "$@"; do
+  if ! pacman -Q -- "$pkg" &>/dev/null; then
+    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
+    exit 1
+  fi
+done
