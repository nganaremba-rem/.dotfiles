diff --git a/niri/bin/niri-keybinds b/niri/bin/niri-keybinds
new file mode 100755
index 0000000..6231d89
--- /dev/null
+++ b/niri/bin/niri-keybinds
@@ -0,0 +1,99 @@
+#!/usr/bin/python3
+"""List every active niri keybind as "KEY  description<TAB>action" lines.
+
+niri has no IPC call for binds, so this reads the config: config.kdl, the
+files it includes, and every `binds { }` block in them. Commented-out binds
+are skipped. Used by the keybindings list (Mod+F1).
+"""
+import re
+import sys
+from pathlib import Path
+
+CONFIG = Path.home() / ".config/niri/config.kdl"
+
+
+
+def strip_comments(text):
+    """Drop // comments, leaving // inside strings (URLs) alone."""
+    out = []
+    for line in text.splitlines():
+        quoted = False
+        for i, char in enumerate(line):
+            if char == '"' and (i == 0 or line[i - 1] != "\\"):
+                quoted = not quoted
+            elif not quoted and line.startswith("//", i):
+                line = line[:i]
+                break
+        out.append(line)
+    return "\n".join(out)
+
+
+def config_files(path, seen=None):
+    seen = seen if seen is not None else set()
+    if path in seen or not path.is_file():
+        return
+    seen.add(path)
+    yield path
+    for match in re.finditer(r'^\s*include\s+(?:optional=\w+\s+)?"([^"]+)"', strip_comments(path.read_text()), re.M):
+        yield from config_files(path.parent / match.group(1), seen)
+
+
+def blocks(text, name):
+    """Yield the body of every top-level `name { ... }` block."""
+    for match in re.finditer(rf"^{name}\s*\{{", text, re.M):
+        depth, start = 1, match.end()
+        for i in range(start, len(text)):
+            depth += {"{": 1, "}": -1}.get(text[i], 0)
+            if depth == 0:
+                yield text[start:i]
+                break
+
+
+def binds(body):
+    """Yield (key, title, action) for each bind in a binds block body."""
+    entry = re.compile(r'^\s*([A-Za-z0-9_+]+)((?:\s+[\w-]+=(?:r#"[^#]*"#|"(?:[^"\\]|\\.)*"|\S+))*)\s*\{', re.M)
+    position = 0
+    while match := entry.search(body, position):
+        depth, start = 1, match.end()
+        end = start
+        for end in range(start, len(body)):
+            depth += {"{": 1, "}": -1}.get(body[end], 0)
+            if depth == 0:
+                break
+        action = " ".join(body[start:end].split()).rstrip(";").strip()
+        title = re.search(r'hotkey-overlay-title="((?:[^"\\]|\\.)*)"', match.group(2))
+        yield match.group(1), title.group(1) if title else describe(action), action
+        position = end + 1
+
+
+def describe(action):
+    """`focus-window-up` → "Focus window up"; spawn commands are shown as typed."""
+    name, _, rest = action.partition(" ")
+    if name.startswith("spawn"):
+        return " ".join(part.strip('"') for part in rest.split())
+    return (name.replace("-", " ") + (" " + rest if rest else "")).capitalize()
+
+
+def main():
+    seen = {}
+    for path in config_files(CONFIG):
+        for body in blocks(strip_comments(path.read_text()), "binds"):
+            for key, title, action in binds(body):
+                seen[key] = (title, action)  # a later file overrides, as in niri
+    width = max(map(len, seen), default=0) + 2
+    for key, (title, action) in seen.items():
+        print(f"{key:<{width}}{title}\t{action}")
+
+
+def demo():
+    sample = 'binds {\n  Mod+K { focus-window-up; }\n  // Mod+Q { quit; }\n  Mod+B hotkey-overlay-title="Web" {\n    spawn-sh "x --app=https://a.b";\n  }\n}'
+    found = [bind for body in blocks(strip_comments(sample), "binds") for bind in binds(body)]
+    assert found == [
+        ("Mod+K", "Focus window up", "focus-window-up"),
+        ("Mod+B", "Web", 'spawn-sh "x --app=https://a.b"'),
+    ], found
+    print("ok")
+
+
+if __name__ == "__main__":
+    demo() if sys.argv[1:] == ["--check"] else main()
diff --git a/niri/bin/niri-layout-toggle b/niri/bin/niri-layout-toggle
new file mode 100755
index 0000000..4b3b37c
--- /dev/null
+++ b/niri/bin/niri-layout-toggle
@@ -0,0 +1,55 @@
+#!/bin/bash
+
+# niri side of the appearance toggles (animations, window gaps, corners).
+# State is flag files; they are rendered into ~/.config/niri/toggles.kdl, which
+# config.kdl includes last and niri reloads on save.
+#
+#   niri-layout-toggle animations|gaps
+#   niri-layout-toggle corners [theme|sharp|rounded]   no value prints the current one
+
+state="$HOME/.local/state/omarchy/toggles/niri"
+out="$HOME/.config/niri/toggles.kdl"
+mkdir -p "$state"
+
+flip() {
+  if [[ -f $state/$1 ]]; then
+    rm "$state/$1"
+  else
+    touch "$state/$1"
+  fi
+}
+
+case "${1:-}" in
+  animations) flip no-animations ;;
+  gaps) flip no-gaps ;;
+  corners)
+    if [[ -z ${2:-} ]]; then
+      cat "$state/corners" 2>/dev/null || echo theme
+      exit 0
+    fi
+    echo "$2" >"$state/corners"
+    ;;
+  *)
+    echo "Usage: niri-layout-toggle animations|gaps|corners [theme|sharp|rounded]" >&2
+    exit 1
+    ;;
+esac
+
+radius=""
+case "$(cat "$state/corners" 2>/dev/null)" in
+  sharp) radius=0 ;;
+  rounded) radius=12 ;;
+esac
+
+{
+  echo "// Generated by niri-layout-toggle from the menu's appearance toggles. Do not edit."
+  if [[ -f $state/no-animations ]]; then
+    echo "animations { off; }"
+  fi
+  if [[ -f $state/no-gaps ]]; then
+    echo "layout { gaps 0; }"
+  fi
+  if [[ -n $radius ]]; then
+    echo "window-rule { geometry-corner-radius $radius; clip-to-geometry true; }"
+  fi
+} >"$out"
