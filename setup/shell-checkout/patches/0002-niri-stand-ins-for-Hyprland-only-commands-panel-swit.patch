+++ b/niri/bin/omarchy-restart-shell
@@ -0,0 +1,11 @@
+#!/bin/bash
+
+# niri stand-in: restart the shell. omarchy-launch-shell supervises it and
+# starts a fresh one when the old one is killed; start the supervisor if it is
+# not there.
+
+pkill -f "quickshell -n -p $OMARCHY_PATH/shell"
+
+if ! pgrep -f "bin/omarchy-launch-shell" >/dev/null; then
+  setsid -f omarchy-launch-shell >/dev/null 2>&1
+fi
