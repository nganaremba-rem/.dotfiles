@@ -0,0 +1,11 @@
+#!/bin/bash
+
+# Which desktop panel is running: "dms" (DankMaterialShell bar, notifications,
+# lock) or "shell" (this shell's own bar and services). The niri stand-ins in
+# this directory route toggles to whichever one is live.
+
+if systemctl --user --quiet is-active dms.service; then
+  echo dms
+else
+  echo shell
+fi
diff --git a/niri/bin/panel-switch b/niri/bin/panel-switch
new file mode 100755
index 0000000..cf01d79
--- /dev/null
+++ b/niri/bin/panel-switch
@@ -0,0 +1,58 @@
+#!/bin/bash
+
+# Switch the desktop panel between DankMaterialShell and this shell's own bar.
+# The shell itself always runs (menu, pickers, reminders); only the bar,
+# notifications, on-screen display, media keys and wallpaper change hands.
+#
+#   panel-switch dms|shell|toggle
+
+# Services the two panels would fight over. The lock screen and idle timer stay
+# off in both modes: the lock needs a PAM service this machine does not have.
+contested=(omarchy.background omarchy.notifications omarchy.osd omarchy.battery omarchy.media)
+
+target=${1:-toggle}
+if [[ $target == "toggle" ]]; then
+  if [[ $(panel-mode) == "dms" ]]; then
+    target=shell
+  else
+    target=dms
+  fi
+fi
+
+case "$target" in
+  shell)
+    systemctl --user stop dms.service
+    # The link goes stale when the theme changed while DMS drew the wallpaper.
+    background="$HOME/.local/state/omarchy/current/background"
+    if [[ ! -e $background ]]; then
+      first=$(find -L "$HOME/.local/state/omarchy/current/theme/backgrounds" -maxdepth 1 -type f | sort | head -n1)
+      [[ -n $first ]] && ln -nsf "$first" "$background"
+    fi
+    for plugin in "${contested[@]}"; do
+      omarchy-shell -q shell setPluginEnabled "$plugin" true
+    done
+    omarchy-toggle-bar off
+    cp "$HOME/.local/state/omarchy/current/theme/niri.kdl" "$HOME/.config/niri/theme.kdl" 2>/dev/null
+    ;;
+  dms)
+    for plugin in "${contested[@]}"; do
+      omarchy-shell -q shell setPluginEnabled "$plugin" false
+    done
+    omarchy-toggle-bar on
+    : >"$HOME/.config/niri/theme.kdl" # border colours go back to DMS
+
+    # dms.service only counts as started once it owns the notification bus
+    # name, and this shell's notification service keeps that name until the
+    # shell restarts without it. Starting DMS first would hang for 90 seconds.
+    omarchy-restart-shell
+    for _ in {1..50}; do
+      busctl --user status org.freedesktop.Notifications &>/dev/null || break
+      sleep 0.2
+    done
+    systemctl --user start --no-block dms.service
+    ;;
+  *)
+    echo "Usage: panel-switch dms|shell|toggle" >&2
+    exit 1
+    ;;
+esac
