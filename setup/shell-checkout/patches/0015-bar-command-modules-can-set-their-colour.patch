From 78b0fa05359862aa62b42a86114a3ae2b42f97e2 Mon Sep 17 00:00:00 2001
From: nganaremba-rem <ngancloverr+remkugithub@gmail.com>
Date: Sun, 11 Oct 2026 22:27:46 +0530
Subject: [PATCH 15/24] bar: command modules can set their colour

A module takes "color" next to its id for a fixed colour, or prints it in
its JSON output to change per run. Theme colour names (red, green, yellow,
blue, magenta, cyan, grey, accent) resolve against the active theme's
colors.toml, so they follow theme switches; other values pass through.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 shell/Commons/Color.qml   | 18 ++++++++++++++++++
 shell/plugins/bar/Bar.qml |  6 ++++++
 2 files changed, 24 insertions(+)

diff --git a/shell/Commons/Color.qml b/shell/Commons/Color.qml
index 0dbcbf6..2eb8ef3 100644
--- a/shell/Commons/Color.qml
+++ b/shell/Commons/Color.qml
@@ -146,9 +146,11 @@ QtObject {
     var color4Value = ""
     var color7Value = ""
     var color8Value = ""
+    var nextPalette = {}
     for (var i = 0; i < lines.length; i++) {
       var match = lines[i].match(/^\s*([A-Za-z0-9_-]+)\s*=\s*["']?(#[0-9A-Fa-f]{6})/)
       if (!match) continue
+      nextPalette[match[1]] = match[2]
       if (match[1] === "foreground") { foreground = match[2]; loadedForeground = true }
       else if (match[1] === "background") { background = match[2]; loadedBackground = true }
       // Prefer the explicit `accent` key; only fall back to color4 when the
@@ -166,6 +168,22 @@ QtObject {
     if (!loadedForeground && color7Value.length > 0) foreground = color7Value
     if (!foundAccent && color4Value.length > 0) accent = color4Value
     if (!foundMuted) muted = color8Value.length > 0 ? color8Value : foreground
+    palette = nextPalette
+  }
+
+  // niri port: every colour of the active theme by its colors.toml key, so a
+  // bar module can ask for one by name and follow theme switches.
+  property var palette: ({})
+
+  // red, green, yellow, blue, magenta, cyan, grey, accent, foreground, or any
+  // other key of the theme's colors.toml give the theme's colour. Anything
+  // else, such as "#a6e3a1", is handed back unchanged. Themes name their
+  // colours either directly (red = …) or as terminal slots (color1 = …).
+  function named(name) {
+    var slots = { red: "color1", green: "color2", yellow: "color3", blue: "color4", magenta: "color5", cyan: "color6" }
+    var key = String(name || "")
+    if (key === "grey" || key === "gray") return String(muted)
+    return palette[key] || palette[slots[key]] || key
   }
 
   // Last theme-supplied and user-supplied shell.toml dicts, kept separate so
diff --git a/shell/plugins/bar/Bar.qml b/shell/plugins/bar/Bar.qml
index f5a372e..ce64a26 100644
--- a/shell/plugins/bar/Bar.qml
+++ b/shell/plugins/bar/Bar.qml
@@ -2146,6 +2146,10 @@ Item {
     property string outputText: ""
     property string outputTooltip: ""
     property bool outputActive: false
+    // niri port: a module can colour itself. `"color"` next to its id sets a
+    // fixed colour; the same key in JSON output sets it per run (a state light).
+    property string outputColor: ""
+    readonly property string colorName: outputColor || String(setting("color", ""))
 
     function setting(name, fallback) {
       var value = settings ? settings[name] : undefined
@@ -2159,9 +2163,11 @@ Item {
       outputText = data.text || String(raw || "").trim()
       outputTooltip = data.tooltip || String(setting("tooltip", ""))
       outputActive = klass === "active" || (Array.isArray(klass) && klass.indexOf("active") !== -1)
+      outputColor = String(data.color || "")
     }
 
     bar: root
+    foreground: colorName !== "" ? Commons.Color.named(colorName) : root.barForeground
     text: outputText || String(setting("text", ""))
     tooltipText: outputTooltip || String(setting("tooltip", ""))
     active: outputActive
