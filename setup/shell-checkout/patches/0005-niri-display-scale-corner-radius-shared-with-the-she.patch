diff --git a/shell/plugins/panels/audio/Panel.qml b/shell/plugins/panels/audio/Panel.qml
index 46cb39a..e8d8f4f 100644
--- a/shell/plugins/panels/audio/Panel.qml
+++ b/shell/plugins/panels/audio/Panel.qml
@@ -125,6 +125,37 @@ Panel {
   // snapshot timer lets the mutation settle first, and closed panels keep their
   // repeaters detached entirely.
   property var displayAudioSinks: []
+
+  // Outputs PipeWire has no node for: HDMI / DisplayPort audio is another
+  // profile of the sound card, so it only becomes a sink once the card
+  // switches. audio-output-profile lists them; a click switches the profile.
+  property var profileOutputs: []
+
+  function loadProfileOutputs(text) {
+    var rows = []
+    var lines = String(text || "").split("\n")
+    for (var i = 0; i < lines.length; i++) {
+      var cols = lines[i].split("\t")
+      if (cols.length === 3) rows.push({ label: cols[0], card: cols[1], profile: cols[2] })
+    }
+    profileOutputs = rows
+  }
+
+  Process {
+    id: profileOutputsProc
+    command: ["audio-output-profile", "list"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: root.loadProfileOutputs(text)
+    }
+  }
+
+  // The card needs a moment to bring the new sink up before the list is right again.
+  Timer {
+    id: profileOutputsRefresh
+    interval: 900
+    onTriggered: profileOutputsProc.running = true
+  }
   property var displayAudioSources: []
   property var displayAudioStreams: []
 
