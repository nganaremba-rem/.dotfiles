@@ -33,6 +33,14 @@ fi
 
 case "$target" in
   shell)
+    # Night light must not blink off in the handover: note what DMS is doing
+    # before it stops, then give the same temperature to this shell.
+    night=$(dms ipc call night status 2>/dev/null)
+    night_temp=""
+    if [[ $night == *"Night mode: enabled"* && $night =~ Current\ temperature:\ ([0-9]+)K ]]; then
+      night_temp=${BASH_REMATCH[1]}
+    fi
+
     touch "$flag"
     # disable as well as stop, or DMS returns at the next login beside this bar
     systemctl --user disable --now dms.service 2>/dev/null
@@ -48,6 +56,10 @@ case "$target" in
     done
     omarchy-toggle-bar off
     cp "$HOME/.local/state/omarchy/current/theme/niri.kdl" "$HOME/.config/niri/theme.kdl" 2>/dev/null
+    if [[ -n $night_temp ]]; then
+      hyprctl hyprsunset temperature "$night_temp"
+      omarchy-shell -q nightlight refresh
+    fi
     ;;
   dms)
     rm -f "$flag"
