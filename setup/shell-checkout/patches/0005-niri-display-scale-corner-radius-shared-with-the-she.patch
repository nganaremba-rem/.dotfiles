diff --git a/niri/bin/omarchy-hyprland-monitor-scaling b/niri/bin/omarchy-hyprland-monitor-scaling
new file mode 100755
index 0000000..0f48b80
--- /dev/null
+++ b/niri/bin/omarchy-hyprland-monitor-scaling
@@ -0,0 +1,53 @@
+#!/bin/bash
+
+# niri stand-in: read or set the focused monitor's scale.
+#
+#   omarchy-hyprland-monitor-scaling            print the current scale
+#   omarchy-hyprland-monitor-scaling up|down    step through the presets
+#   omarchy-hyprland-monitor-scaling 1.25       set it
+#
+# The scale is applied at once and written into ~/.config/niri/dms/outputs.kdl,
+# the file niri reads its outputs from. A runtime-only change would be lost at
+# the next config reload.
+
+SCALES=(1 1.25 1.6 2 3 4)
+outputs_file="$HOME/.config/niri/dms/outputs.kdl"
+
+monitor=$(niri msg -j focused-output | jq -r '.name // empty')
+current=$(niri msg -j focused-output | jq -r '.logical.scale // 1')
+[[ -n $monitor ]] || exit 1
+
+case "${1:-}" in
+  "")
+    printf '%g\n' "$current"
+    exit 0
+    ;;
+  up | down)
+    target=$current
+    for i in "${!SCALES[@]}"; do
+      if awk -v a="${SCALES[$i]}" -v b="$current" 'BEGIN { exit !(a == b) }'; then
+        if [[ $1 == "up" ]]; then
+          target=${SCALES[$((i + 1 < ${#SCALES[@]} ? i + 1 : i))]}
+        else
+          target=${SCALES[$((i > 0 ? i - 1 : 0))]}
+        fi
+      fi
+    done
+    ;;
+  *)
+    [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "Usage: omarchy-hyprland-monitor-scaling [up|down|SCALE]" >&2; exit 1; }
+    target=$1
+    ;;
+esac
+
+niri msg output "$monitor" scale "$target" || exit 1
+
+# Persist: rewrite the scale line inside this monitor's output block only.
+if [[ -f $outputs_file ]]; then
+  awk -v monitor="$monitor" -v scale="$target" '
+    $1 == "output" { inside = ($2 == "\"" monitor "\"") }
+    inside && $1 == "scale" { sub(/scale[ \t]+[0-9.]+/, "scale " scale) }
+    $1 == "}" { inside = 0 }
+    { print }
+  ' "$outputs_file" >"$outputs_file.tmp" && mv "$outputs_file.tmp" "$outputs_file"
+fi
