diff --git a/niri/bin/audio-output-profile b/niri/bin/audio-output-profile
new file mode 100755
index 0000000..b9cd63c
--- /dev/null
+++ b/niri/bin/audio-output-profile
@@ -0,0 +1,38 @@
+#!/bin/bash
+
+# Outputs that exist only as another profile of a sound card. On most laptops
+# HDMI / DisplayPort audio is one: PipeWire shows a single sink for the card's
+# active profile, so the monitors never appear as outputs until the card
+# switches profile. The audio panel lists these and switches on click.
+#
+#   audio-output-profile list                  label<TAB>card<TAB>profile per output
+#   audio-output-profile set <card> <profile>
+
+case "${1:-}" in
+  list)
+    pactl -f json list cards | jq -r '
+      .[] | .name as $card | .active_profile as $active | .profiles as $profiles
+      # keep the current input half of the profile, so the microphone stays
+      | (($active | capture("(?<input>\\+input:.*)$").input) // "") as $input
+      | .ports | to_entries[]
+      | select(.key | test("-output"))
+      | select(.value.availability != "not available")
+      | select((.value.profiles // []) | index($active) | not)
+      | [.value.profiles[] | select($profiles[.].available != false)] as $candidates
+      | select($candidates | length > 0)
+      | (first($candidates[] | select(test("stereo") and endswith($input) and ($input != "")))
+         // first($candidates[] | select(test("stereo")))
+         // $candidates[0]) as $profile
+      | (.value.properties["device.product.name"] // "") as $product
+      | [(.value.description + (if $product != "" then " (" + $product + ")" else "" end)), $card, $profile]
+      | @tsv'
+    ;;
+  set)
+    [[ -n ${2:-} && -n ${3:-} ]] || { echo "Usage: audio-output-profile set <card> <profile>" >&2; exit 1; }
+    pactl set-card-profile "$2" "$3"
+    ;;
+  *)
+    echo "Usage: audio-output-profile list | set <card> <profile>" >&2
+    exit 1
+    ;;
+esac
