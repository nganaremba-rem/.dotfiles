From 205e4f59fcdd80908c4095e9355cddaaade5d944 Mon Sep 17 00:00:00 2001
From: nganaremba-rem <ngancloverr+remkugithub@gmail.com>
Date: Sun, 11 Oct 2026 23:05:59 +0530
Subject: [PATCH 16/24] shell: more normal-mode keys, faster emoji grid,
 centred lone icons

Normal mode gains gg/G, Ctrl+d/u/f/b, x and dd (delete), cc and S (clear the
filter and type again); each surface now handles Home and End for them.

The emoji and icon grid used a ListModel rebuilt row by row on every key,
which lagged with 10,000 icons. It now takes the filtered array directly.

A bar label that is a single icon glyph is centred on the icon instead of on
digit height, so icons of any size sit on the bar's middle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 shell/Commons/Vim.qml                      | 98 ++++++++++++++++++----
 shell/Ui/OverlayWindow.qml                 |  2 +-
 shell/Ui/WidgetButton.qml                  | 17 +++-
 shell/plugins/clipboard/Clipboard.qml      |  7 ++
 shell/plugins/emojis/Emojis.qml            | 54 ++++++------
 shell/plugins/image-picker/ImagePicker.qml |  9 ++
 shell/plugins/menu/Menu.qml                |  9 ++
 7 files changed, 150 insertions(+), 46 deletions(-)

diff --git a/shell/Commons/Vim.qml b/shell/Commons/Vim.qml
index 9adfb51..4355be6 100644
--- a/shell/Commons/Vim.qml
+++ b/shell/Commons/Vim.qml
@@ -4,31 +4,50 @@ import Quickshell
 
 // niri port: modal keys for the type-to-filter surfaces (menu, image picker,
 // emoji, clipboard, reminder). A surface opens in insert mode, where typing
-// filters as before. Esc switches to normal mode, where h j k l move and
-// letters do not type. Esc again (or q) closes; i, a or / goes back to typing.
+// filters as before. Esc switches to normal mode, where keys move instead of
+// type. Esc again (or q) closes.
+//
+// Normal mode:
+//   h j k l          move
+//   gg  G            first, last
+//   Ctrl+d  Ctrl+u   page down, page up (also Ctrl+f, Ctrl+b)
+//   x  dd            delete the highlighted item, where the surface can
+//   cc  S            clear the filter and type again
+//   i a I A /        type again
+//   Esc  q           close
+//
 // Bar panels are not modal: PanelKeyCatcher already takes h j k l there.
 Singleton {
   id: root
 
   property bool normal: false
+  // First key of a two-key command (gg, dd, cc), forgotten after a moment.
+  property string pending: ""
 
   // OverlayWindow calls this each time a surface is shown.
-  function reset() { normal = false }
-
-  readonly property var motions: ({
-    "h": Qt.Key_Left, "j": Qt.Key_Down, "k": Qt.Key_Up, "l": Qt.Key_Right,
-    "d": Qt.Key_PageDown, "u": Qt.Key_PageUp
-  })
+  function reset() {
+    normal = false
+    pending = ""
+  }
 
   // Keys normal mode hands on unchanged.
   readonly property var passed: [
     Qt.Key_Return, Qt.Key_Enter, Qt.Key_Left, Qt.Key_Right, Qt.Key_Up, Qt.Key_Down,
-    Qt.Key_PageUp, Qt.Key_PageDown, Qt.Key_Tab, Qt.Key_Backtab, Qt.Key_Delete
+    Qt.Key_PageUp, Qt.Key_PageDown, Qt.Key_Home, Qt.Key_End, Qt.Key_Tab, Qt.Key_Backtab, Qt.Key_Delete
   ]
 
+  function key(code, modifiers) {
+    return { key: code, modifiers: modifiers || Qt.NoModifier, text: "", accepted: true }
+  }
+
+  function insert() {
+    normal = false
+    return null
+  }
+
   // First line of a Keys.onPressed handler: `event = Vim.translate(event, quit)`.
-  // Returns the event to handle (h j k l arrive as arrow keys), or null when
-  // the key was used up here. `quit` closes the surface.
+  // Returns the event to handle (motions arrive as the plain keys the surface
+  // already knows), or null when the key was used up here. `quit` closes it.
   function translate(event, quit) {
     if (!normal) {
       if (event.key !== Qt.Key_Escape) return event
@@ -37,17 +56,64 @@ Singleton {
       return null
     }
 
-    if (passed.indexOf(event.key) !== -1) return event
+    var first = pending
+    pending = ""
+    pendingTimeout.stop()
 
+    if (passed.indexOf(event.key) !== -1) return event
     event.accepted = true
-    if (event.key === Qt.Key_Escape || event.text === "q") {
+
+    if (event.modifiers & Qt.ControlModifier) {
+      if (event.key === Qt.Key_D || event.key === Qt.Key_F) return key(Qt.Key_PageDown)
+      if (event.key === Qt.Key_U || event.key === Qt.Key_B) return key(Qt.Key_PageUp)
+      return null
+    }
+
+    if (event.key === Qt.Key_Escape) {
       normal = false
       quit()
-    } else if (event.text === "i" || event.text === "a" || event.text === "/") {
+      return null
+    }
+
+    switch (event.text) {
+    case "h": return key(Qt.Key_Left)
+    case "j": return key(Qt.Key_Down)
+    case "k": return key(Qt.Key_Up)
+    case "l": return key(Qt.Key_Right)
+    case "G": return key(Qt.Key_End)
+    case "x": return key(Qt.Key_Delete)
+    case "g":
+    case "d":
+    case "c":
+      if (first !== event.text) {
+        pending = event.text
+        pendingTimeout.restart()
+        return null
+      }
+      if (event.text === "g") return key(Qt.Key_Home)
+      if (event.text === "d") return key(Qt.Key_Delete)
+      insert()
+      return key(Qt.Key_U, Qt.ControlModifier)   // cc: the surfaces clear on Ctrl+U
+    case "S":
+      insert()
+      return key(Qt.Key_U, Qt.ControlModifier)
+    case "i":
+    case "a":
+    case "I":
+    case "A":
+    case "/":
+      return insert()
+    case "q":
       normal = false
-    } else if (event.text in motions) {
-      return { key: motions[event.text], modifiers: Qt.NoModifier, text: "", accepted: true }
+      quit()
+      return null
     }
     return null
   }
+
+  Timer {
+    id: pendingTimeout
+    interval: 700
+    onTriggered: root.pending = ""
+  }
 }
