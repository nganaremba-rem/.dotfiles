diff --git a/shell/Ui/WidgetButton.qml b/shell/Ui/WidgetButton.qml
index 9267f1d..510bcd8 100644
--- a/shell/Ui/WidgetButton.qml
+++ b/shell/Ui/WidgetButton.qml
@@ -83,9 +83,22 @@ Item {
     // Centering the line box puts the figures above the bar's middle, since
     // the box keeps room for descenders. Center the figure height instead, so
     // labels line up with the icons beside them.
-    anchors.verticalCenterOffset: !root.centerFigures || root.vertical || root.text.indexOf("\n") !== -1
+    // niri port: a label that is one icon glyph is centred on the icon, not on
+    // digits. Nerd Font draws every icon around the same point, 0.348 em above
+    // the baseline (measured from the font's outlines; Qt's own tight bounds
+    // are wrong for some of these glyphs). The half pixel matches where the
+    // bar's icon buttons land.
+    readonly property bool loneIcon: {
+      var first = root.text.length > 0 ? root.text.codePointAt(0) : 0
+      return first >= 0xE000 && root.text.length === (first > 0xFFFF ? 2 : 1)
+    }
+    anchors.verticalCenterOffset: root.vertical || root.text.indexOf("\n") !== -1
       ? 0
-      : (labelMetrics.descent - labelMetrics.ascent + labelMetrics.tightBoundingRect("0").height) / 2
+      : loneIcon
+        ? Math.round(label.height / 2 - label.baselineOffset + label.font.pixelSize * 0.348 + 0.5)
+        : !root.centerFigures
+          ? 0
+          : (labelMetrics.descent - labelMetrics.ascent + labelMetrics.tightBoundingRect("0").height) / 2
     text: root.text
     color: root.active && root.useActiveColor ? root.activeColor : root.foreground
     font.family: root.fontFamily
