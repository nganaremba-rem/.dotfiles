[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = grub

[Action]
Description = Reinstalling GRUB to ESP + removable fallback path...
When = PostTransaction
Exec = /bin/sh -c 'grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --recheck && grub-install --target=x86_64-efi --efi-directory=/boot --removable --recheck && grub-mkconfig -o /boot/grub/grub.cfg'
