#!/usr/bin/env bash
# ⌨️ Mod+Alt+K: toggle wshowkeys (key bubbles bottom-right, fade on their own, click-through).
if pgrep -x wshowkeys >/dev/null; then
    pkill -x wshowkeys
else
    exec wshowkeys -a bottom -a right -m 40 -t 1800 -F 'JetBrainsMono Nerd Font 24' \
        -b '#11111bF2' -f '#cdd6f4' -s '#89b4fa'
fi
