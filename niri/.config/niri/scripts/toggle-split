#!/bin/bash
# Flip the focused window between sharing a column (stacked top to bottom) and
# having a column of its own (side by side). niri has no layout modes to switch;
# this is its nearest thing to Hyprland's togglesplit.
set -euo pipefail

windows=$(niri msg -j windows)
focused=$(jq -c '.[] | select(.is_focused)' <<<"$windows")
[[ -n $focused && $(jq -r .is_floating <<<"$focused") == "false" ]] || exit 0

workspace=$(jq -r .workspace_id <<<"$focused")
column=$(jq -r '.layout.pos_in_scrolling_layout[0]' <<<"$focused")
in_column=$(jq --argjson ws "$workspace" --argjson col "$column" \
    '[.[] | select(.workspace_id == $ws and (.is_floating | not) and .layout.pos_in_scrolling_layout[0] == $col)] | length' <<<"$windows")

if ((in_column > 1)); then
    # Stacked: move out into a column of its own, on the right.
    niri msg action consume-or-expel-window-right
elif ((column > 1)); then
    # Alone: join the column on the left, underneath it.
    niri msg action consume-or-expel-window-left
else
    # Leftmost column: nothing on the left to join, so join the right one.
    niri msg action consume-or-expel-window-right
fi
