#!/bin/bash
# Universal copy / paste / cut for Mod+C / Mod+V: Ctrl+Shift+C/V in terminals,
# plain Ctrl+C/V/X everywhere else (also launcher and menu text fields).
#
# vkchord (built from vkchord.c on first use) types the chord into the focused
# window through a Wayland virtual keyboard with its own modifier state. So it
# fires at once, while the window of the key press still has focus, and the
# Super still held for the bind is never part of it. (ydotool's uinput keys
# merged with that Super, so uclip had to wait for Super-up: by then focus
# could have moved on, and after 1 s the chord went out anyway as
# Mod+Ctrl+C/V, which are niri binds.) UCLIP_BACKEND from the emoji picker is
# no longer needed and ignored.
#
# Terminal paste with only an image on the clipboard sends plain Ctrl+V, so
# TUIs that read the clipboard themselves (Claude Code, Codex) get the image;
# the terminal's own paste only takes text. A terminal copy that changes
# nothing (no selection in the terminal itself) takes the PRIMARY selection,
# and paste waits for that copy, so a quick Mod+C then Mod+V pastes the new text.
case ${1:-} in
copy) key=46 ;;
paste) key=47 ;;
cut) key=45 ;;
*)
    echo "usage: uclip copy|paste|cut" >&2
    exit 2
    ;;
esac

# Window owned by a terminal emulator process (footclient windows belong to
# the foot server, whatever their app id). No focused window = a layer surface
# (launcher, menu) has the keyboard.
pid=$(niri msg -j focused-window | jq -r '.pid // empty')
exe=$(readlink "/proc/$pid/exe")
case ${exe##*/} in
foot | kitty | alacritty | ghostty | wezterm-gui) mods=ctrl+shift ;;
*) mods=ctrl ;;
esac

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/uclip.lock"
flock -w 1 9

src=${BASH_SOURCE[0]%/*}/vkchord.c
vkchord=${XDG_CACHE_HOME:-$HOME/.cache}/niri/vkchord
if [[ ! $vkchord -nt $src ]]; then
    mkdir -p "${vkchord%/*}" &&
        cc -O2 -o "$vkchord.new" "$src" -lwayland-client &&
        mv -f "$vkchord.new" "$vkchord" || exit 1
fi

text() { timeout 0.5 wl-paste -n -t text "$@" 2>/dev/null; }

if [[ $1 == paste && $mods == ctrl+shift ]]; then
    types=$(timeout 0.5 wl-paste -l 2>/dev/null)
    if [[ $types == *image/* ]] && ! grep -qxE 'text/plain.*|UTF8_STRING|STRING|TEXT|text/uri-list' <<<"$types"; then
        mods=ctrl
    fi
fi

if [[ $1 != copy || $mods == ctrl ]]; then
    exec "$vkchord" "$mods" "$key"
fi
before=$(text | md5sum)
"$vkchord" "$mods" "$key"
for _ in {1..12}; do
    sleep 0.02
    [[ $(text | md5sum) != "$before" ]] && exit 0
done
sel=$(text -p)
[[ -n $sel ]] && printf %s "$sel" | wl-copy
