#!/bin/bash
# Universal copy / paste / cut for Mod+C / Mod+V / Mod+X:
# Ctrl+Shift+C/V in terminals, plain Ctrl+C/V/X everywhere else.
#
# Keys go out as real uinput events (ydotool). wtype's private virtual keymap
# is ignored by GTK3, Chromium/CEF and XWayland clients, so it is not used.
# Because uinput events join the physical modifier state, the chord waits
# until the Super key of the bind is physically up (polled with EVIOCGKEY on
# every keyboard) before injecting Ctrl[+Shift]+key.
#
# copy/cut hold a lock until the clipboard actually changed (or 0.6 s passed)
# and paste takes the same lock first, so a quick Mod+C then Mod+V can no
# longer paste the previous clipboard. In a terminal a copy that changed
# nothing (no selection) falls back to the PRIMARY selection.
#
# UCLIP_BACKEND=uinput skips the Super wait for callers with no key held (the
# emoji and icon pickers).
case "${1:-}" in
copy) code=46 ;;
paste) code=47 ;;
cut) code=45 ;;
*)
    echo "usage: uclip copy|paste|cut" >&2
    exit 2
    ;;
esac

window=$(niri msg -j focused-window)
app=$(jq -r '.app_id // ""' <<<"$window")
case "$app" in
foot | footclient | kitty | Alacritty | com.mitchellh.ghostty | org.wezfurlong.wezterm | scratchpad | btop | qsmenu-term | herdr.* | org.omarchy.* | TUI*)
    terminal=true
    ;;
*)
    terminal=false
    ;;
esac

# Wait (max 1 s) until no Super key is held on any keyboard.
wait_super_up() {
    /usr/bin/python3 -I - <<'EOF'
import evdev, re, time
devs = []
for blk in open("/proc/bus/input/devices").read().split("\n\n"):
    m = re.search(r"Handlers=.*\bkbd\b.*\b(event\d+)", blk)
    if m:
        try:
            devs.append(evdev.InputDevice("/dev/input/" + m.group(1)))
        except OSError:
            pass
end = time.time() + 1
while time.time() < end:
    if not any({125, 126} & set(d.active_keys()) for d in devs):
        break
    time.sleep(0.01)
EOF
}

send() {
    if [[ $terminal == true ]]; then
        ydotool key 29:1 42:1 "$code:1" "$code:0" 42:0 29:0 # Ctrl+Shift+key
    else
        ydotool key 29:1 "$code:1" "$code:0" 29:0 # Ctrl+key
    fi
}

clip_sum() { wl-paste -n 2>/dev/null | md5sum; }

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/uclip.lock"
flock -w 3 9

[[ ${UCLIP_BACKEND:-} == uinput ]] || wait_super_up

case $1 in
paste)
    send
    sleep 0.05 # let the app issue its paste request before the lock drops
    ;;
*)
    before=$(clip_sum)
    send
    tries=30 # 0.6 s
    [[ $terminal == true ]] && tries=12
    for _ in $(seq "$tries"); do
        sleep 0.02
        [[ $(clip_sum) != "$before" ]] && exit 0
    done
    # Terminal with nothing selected-for-clipboard: use the PRIMARY selection.
    if [[ $terminal == true && $1 == copy ]]; then
        sel=$(wl-paste -p -n 2>/dev/null)
        [[ -n $sel ]] && printf %s "$sel" | wl-copy
    fi
    ;;
esac
