// 🚀 App launchers. Default apps are variables — change them in settings/apps.kdl.
// "Mod" = Super. Titles show up in the hotkey overlay (Mod+Shift+/).

binds {
    // ── 💻 Terminals ─────────────────────────────────────────────────────────
    Mod+Return           hotkey-overlay-title="💻 Terminal"                  { spawn-sh "$NIRI_TERMINAL"; }
    Mod+Alt+Return       hotkey-overlay-title="💻 Terminal + tmux"           { spawn-sh "$NIRI_TERMINAL_RUN tmux"; }
    Mod+Ctrl+Return      hotkey-overlay-title="💻 Terminal + herdr session"  { spawn-sh "~/.config/herdr/session-picker.sh open default"; }
    Mod+Apostrophe       hotkey-overlay-title="📌 Scratchpad terminal"       { spawn-sh "$NIRI_TERMINAL --class=scratchpad"; }
    Mod+Slash            hotkey-overlay-title="👻 Ghostty"                    { spawn "ghostty"; }

    // ── 📝 Core apps ─────────────────────────────────────────────────────────
    Mod+N                hotkey-overlay-title="📝 Neovim"                     { spawn-sh "$NIRI_TERMINAL_RUN $NIRI_EDITOR"; }
    Mod+B                hotkey-overlay-title="🌐 Browser"                    { spawn-sh "$NIRI_BROWSER --new-window"; }
    Mod+E                hotkey-overlay-title="📁 File manager"               { spawn-sh "$NIRI_FILE_MANAGER"; }
    Mod+Alt+B          hotkey-overlay-title="🌐 Vimb"                       { spawn-sh "vimb"; }

    // ── 🔎 Launchers & pickers ───────────────────────────────────────────────
    Mod+Space            hotkey-overlay-title="🔎 App launcher (DMS)"        { spawn-sh "$NIRI_LAUNCHER"; }
    Alt+Space            hotkey-overlay-title="🚀 App launcher (rofi)"       { spawn-sh "rofi -show drun"; }
    Mod+Shift+Return     hotkey-overlay-title="🚀 App launcher (rofi)"       { spawn-sh "rofi -show drun"; }
    Mod+Alt+Space        hotkey-overlay-title="🪟 Open windows"               { spawn-sh "rofi -show window"; }
    Alt+W                hotkey-overlay-title="🪟 Open windows"               { spawn-sh "rofi -show window"; }
    Mod+Ctrl+E           hotkey-overlay-title="😀 Emoji picker"               { spawn-sh "rofi -show emoji"; }
    Mod+P                hotkey-overlay-title="🔍 Web search"                 { spawn-sh "~/.config/rofi/rofi/scripts/websearch"; }

    // ── 🧰 Terminal tools ────────────────────────────────────────────────────
    // btop's --app-id is a foot flag: dms/windowrules.kdl opens app-id "btop" maximized.
    Mod+Shift+T          hotkey-overlay-title="📊 btop"                       { spawn-sh "$NIRI_TERMINAL --app-id=btop -- btop"; }
    Mod+Ctrl+T           hotkey-overlay-title="📈 RemTop"                     { spawn-sh "$NIRI_TERMINAL remtop"; }
    Mod+D                hotkey-overlay-title="✅ Todo (taskwarrior-tui)"     { spawn-sh "$NIRI_TERMINAL_RUN taskwarrior-tui"; }
    Mod+Ctrl+Alt+V       hotkey-overlay-title="🔊 Sound mixer (wiremix)"      { spawn-sh "$NIRI_TERMINAL_RUN wiremix"; }
    Mod+Ctrl+Alt+W       hotkey-overlay-title="📶 Wi-Fi (wlctl)"              { spawn-sh "rfkill unblock wifi && $NIRI_TERMINAL_RUN wlctl"; }
    Mod+Ctrl+Alt+Return  hotkey-overlay-title="🤖 Claude Code"                { spawn-sh "$NIRI_TERMINAL_RUN claude --dangerously-skip-permissions"; }
    Mod+Alt+I            hotkey-overlay-title="🧰 REMTUI"                     { spawn "~/.local/bin/remtui"; }

    // ── 🎨 DankMaterialShell ─────────────────────────────────────────────────
    Mod+S                hotkey-overlay-title="⚙️ DMS settings"               { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+V                hotkey-overlay-title="📋 Clipboard history"          { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Ctrl+Alt+N       hotkey-overlay-title="🔔 Notification center"        { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Ctrl+Alt+B       hotkey-overlay-title="🖼️ Wallpapers"                 { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Mod+Ctrl+W           hotkey-overlay-title="📊 Toggle bar"                 { spawn "dms" "ipc" "call" "bar" "toggle" "index" "0"; }

    // ── ✨ Utilities ──────────────────────────────────────────────────────────
    Mod+Alt+T            hotkey-overlay-title="🈂️ Screen translate (OCR)"     { spawn "screen-translate"; }
    Mod+Ctrl+X           hotkey-overlay-title="🎙️ Voxtype dictation"          { spawn-sh "voxtype record toggle"; }
    Mod+Ctrl+N           hotkey-overlay-title="🌙 Night light"                { spawn "~/bin/arch/toggle-gammastep"; }
    Mod+Ctrl+Alt+A       hotkey-overlay-title="🎞️ Animation curve picker"     { spawn "niri-curve-pick"; }
}
