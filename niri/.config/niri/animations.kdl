animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }

    window-open {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 120
        curve "ease-out-expo"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=600 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 120
        curve "ease-out-expo"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=1400 epsilon=0.001
    }
}
