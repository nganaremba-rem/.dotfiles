animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }
    window-open {
        duration-ms 180
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    window-close {
        duration-ms 120
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.7 stiffness=600 epsilon=0.01
    }
    screenshot-ui-open {
        duration-ms 120
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=1400 epsilon=0.001
    }
}
