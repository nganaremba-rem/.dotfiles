window-rule {
  match app-id="^foot(client)?$"
  background-effect {
    blur true
  }
}


window-rule {
  match app-id="^kitty$"
  background-effect {
    blur true
  }
}


layer-rule {
    match namespace="wlogout"
    background-effect {
        blur true
        xray false
    }
}


window-rule {
    match app-id=r#"^btop$"#
    open-maximized true
}
