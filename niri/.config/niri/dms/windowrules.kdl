// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^foot(client)?$"
    match app-id="^kitty$"
    match app-id="^neovide$"
    open-on-workspace "terminal"
    background-effect {
        blur true
    }
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^btop$"
    open-maximized true
    open-on-workspace "terminal"
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^scratchpad$"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
    background-effect {
        blur true
    }
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="helium"
    match app-id="google-chrome"
    match app-id="zen"
    match app-id="librewolf"
    match app-id="chrome-*"
    open-on-workspace "browser"
}
