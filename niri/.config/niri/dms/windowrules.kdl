// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^foot(client)?$"
    background-effect {
        blur true
    }
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}


// @id=dms_rule_2 @name=
window-rule {
    match app-id="^btop$"
    open-maximized true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}



window-rule {
  match app-id=r#"^scratchpad$"#
  open-floating true
  default-column-width { fixed 1200; }
  default-window-height { fixed 800; }
  // open-centered true
}



layer-rule {
    match namespace="wlogout"
    background-effect {
        blur true
        xray false
    }
}
