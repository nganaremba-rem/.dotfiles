// Generated from the active theme: niri border and focus colours.
// Copied to ~/.config/niri/theme.kdl while the shell panel is in use.
layout {
    focus-ring {
        active-color "#89b4fa"
        inactive-color "#585b70"
    }
    border {
        active-color "#89b4fa"
        inactive-color "#585b70"
    }
    tab-indicator {
        active-color "#89b4fa"
        inactive-color "#585b70"
    }
    insert-hint {
        color "#89b4fa80"
    }
}
