// ╭──────────────────────────────────────────────────────────────────────────╮
// │  🧭  niri — entry point                                                  │
// │                                                                          │
// │  This file only wires modules together. Edit the module, not this file.  │
// │  Docs: https://niri-wm.github.io/niri/  ·  check: `niri validate`        │
// ╰──────────────────────────────────────────────────────────────────────────╯
//
//  📂 Layout
//    settings/   🎯 apps (default-app variables) · ⌨️ input · 📐 layout
//                🎞️ animations · ⚙️ misc · 🚀 startup
//    rules/      🪟 windows · 🧱 layers
//    binds/      ⌨️ one file per topic (apps, web apps, windows, …)
//    dms/        🎨 generated by DankMaterialShell — do NOT edit, DMS overwrites
//    archive/    🗄️ old modules nothing includes (kept for reference)
//
//  ⚠️ Order matters: sections merge and later values win; window rules apply in
//  include order. dms/ is included last on purpose, so its theme, outputs and
//  rules override the modules above it.

// ── 🎯 Settings ──────────────────────────────────────────────────────────────
include "settings/apps.kdl"
include "settings/input.kdl"
include "settings/layout.kdl"
include "settings/animations.kdl"
include "settings/misc.kdl"
include "settings/startup.kdl"

// ── 🪟 Rules ─────────────────────────────────────────────────────────────────
include "rules/windows.kdl"
include "rules/layers.kdl"

// ── ⌨️ Keybindings ───────────────────────────────────────────────────────────
include "binds/apps.kdl"
include "binds/web-apps.kdl"
include "binds/windows.kdl"
include "binds/workspaces.kdl"
include "binds/media.kdl"
include "binds/screenshots.kdl"
include "binds/session.kdl"
include "binds/alt-tab.kdl"

// ── 🎨 DankMaterialShell (generated — keep last) ────────────────────────────
// 🖥️ Outputs: dms/outputs.kdl is the single source of truth; `dms greeter sync`
// copies it to the greeter so login screen and session use identical modes.
// Don't add a second output generator (old nwg-displays monitor.kdl, now in
// archive/): duplicate `output` blocks once left the greeter at 60 Hz and the
// session at 100.087 Hz, forcing a visible modeset blink at every login.
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/windowrules.kdl"
include "dms/binds.kdl"
