[Unit]
Description=Set CPU Energy Performance Preference to balance_power
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo balance_power > "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
