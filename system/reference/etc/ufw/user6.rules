*filter
:ufw6-user-input - [0:0]
:ufw6-user-output - [0:0]
:ufw6-user-forward - [0:0]
:ufw6-before-logging-input - [0:0]
:ufw6-before-logging-output - [0:0]
:ufw6-before-logging-forward - [0:0]
:ufw6-user-logging-input - [0:0]
:ufw6-user-logging-output - [0:0]
:ufw6-user-logging-forward - [0:0]
:ufw6-after-logging-input - [0:0]
:ufw6-after-logging-output - [0:0]
:ufw6-after-logging-forward - [0:0]
:ufw6-logging-deny - [0:0]
:ufw6-logging-allow - [0:0]
:ufw6-user-limit - [0:0]
:ufw6-user-limit-accept - [0:0]
### RULES ###

### tuple ### allow any any ::/0 any ::/0 in_tailscale0 comment=7461696c7363616c65206d657368202d2074727573746564
-A ufw6-user-input -i tailscale0 -j ACCEPT

### tuple ### allow udp 41641 ::/0 any ::/0 in comment=7461696c7363616c652064697265637420636f6e6e656374696f6e73
-A ufw6-user-input -p udp --dport 41641 -j ACCEPT

### tuple ### route:allow any any ::/0 any ::/0 in_wlan0!out_enp0s20f0u6
-A ufw6-user-forward -i wlan0 -o enp0s20f0u6 -j ACCEPT

### tuple ### allow udp 53 ::/0 any ::/0 in_docker0 comment=446f636b657220636f6e7461696e657220444e5320746f207265736f6c7665642073747562
-A ufw6-user-input -i docker0 -p udp --dport 53 -j ACCEPT

### tuple ### allow tcp 53 ::/0 any ::/0 in_docker0 comment=446f636b657220636f6e7461696e657220444e5320746f207265736f6c7665642073747562
-A ufw6-user-input -i docker0 -p tcp --dport 53 -j ACCEPT

### tuple ### allow any any ::/0 any ::/0 in_wg0
-A ufw6-user-input -i wg0 -j ACCEPT

### tuple ### allow tcp 80 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 80 -j ACCEPT

### tuple ### allow tcp 443 ::/0 any ::/0 in
-A ufw6-user-input -p tcp --dport 443 -j ACCEPT

### tuple ### allow udp 443 ::/0 any ::/0 in
-A ufw6-user-input -p udp --dport 443 -j ACCEPT

### tuple ### allow any any ::/0 any ::/0 in_zteywsj4gh
-A ufw6-user-input -i zteywsj4gh -j ACCEPT

### tuple ### allow any any ::/0 any ::/0 in_virbr0
-A ufw6-user-input -i virbr0 -j ACCEPT

### tuple ### route:allow any any ::/0 any ::/0 in_virbr0
-A ufw6-user-forward -i virbr0 -j ACCEPT

### tuple ### route:allow any any ::/0 any ::/0 out_virbr0
-A ufw6-user-forward -o virbr0 -j ACCEPT

### tuple ### allow udp 4500 ::/0 any ::/0 in comment=576972654775617264
-A ufw6-user-input -p udp --dport 4500 -j ACCEPT

### END RULES ###

### LOGGING ###
-A ufw6-after-logging-input -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw6-after-logging-forward -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-I ufw6-logging-deny -m conntrack --ctstate INVALID -j RETURN -m limit --limit 3/min --limit-burst 10
-A ufw6-logging-deny -j LOG --log-prefix "[UFW BLOCK] " -m limit --limit 3/min --limit-burst 10
-A ufw6-logging-allow -j LOG --log-prefix "[UFW ALLOW] " -m limit --limit 3/min --limit-burst 10
### END LOGGING ###

### RATE LIMITING ###
-A ufw6-user-limit -m limit --limit 3/minute -j LOG --log-prefix "[UFW LIMIT BLOCK] "
-A ufw6-user-limit -j REJECT
-A ufw6-user-limit-accept -j ACCEPT
### END RATE LIMITING ###
COMMIT
